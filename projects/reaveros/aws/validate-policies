#!/usr/bin/env bash

set -euo pipefail

usage()
{
    printf 'usage: %s <cloudformation-template>\n' "$0"
}

if [[ $# -ne 1 ]]; then
    usage >&2
    exit 2
fi

required_environment=(
    AWS_BUDGET_NOTIFICATION_EMAIL
    AWS_GITHUB_OIDC_PROVIDER_ARN
    AWS_GITHUB_OIDC_REPOSITORY_SUBJECT_PATTERN
    AWS_GITHUB_RUNNER_GROUP_ID
    AWS_REGION
    AWS_RUNNER_ROLE_PERMISSIONS_BOUNDARY_ARN
)
for variable in "${required_environment[@]}"; do
    if [[ -z ${!variable:-} ]]; then
        printf 'Required environment variable is not set: %s\n' "${variable}" >&2
        exit 2
    fi
done

cfn-policy-validator validate \
    --template-path "$1" \
    --region "${AWS_REGION}" \
    --parameters \
    "BudgetNotificationEmail=${AWS_BUDGET_NOTIFICATION_EMAIL}" \
    "GitHubOidcProviderArn=${AWS_GITHUB_OIDC_PROVIDER_ARN}" \
    "GitHubOidcImmutableRepositoryPattern=${AWS_GITHUB_OIDC_REPOSITORY_SUBJECT_PATTERN}" \
    "GitHubRunnerGroupId=${AWS_GITHUB_RUNNER_GROUP_ID}" \
    "RunnerRolePermissionsBoundaryArn=${AWS_RUNNER_ROLE_PERMISSIONS_BOUNDARY_ARN}"
