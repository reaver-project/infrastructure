#!/usr/bin/env bash

set -euo pipefail

required_environment=(
    AWS_REGION
    AWS_RUNNER_STACK_NAME
    GITHUB_OUTPUT
    GITHUB_SHA
)
for environment_variable in "${required_environment[@]}"; do
    if [[ -z ${!environment_variable:-} ]]; then
        printf 'Required environment variable is empty: %s\n' \
            "${environment_variable}" >&2
        exit 2
    fi
done

self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repository_root=$(git -C "${self_dir}" rev-parse --show-toplevel)
source_revision=$(git -C "${repository_root}" rev-parse HEAD)
source_contract_version=$(< "${self_dir}/../infrastructure-contract-version")
if [[ ! ${GITHUB_SHA} =~ ^[0-9a-f]{40}$ ||
    ${source_revision} != "${GITHUB_SHA}" ||
    ! ${source_contract_version} =~ ^[1-9][0-9]*$ ]]; then
    printf 'The checked-out infrastructure source is not the deployment revision.\n' >&2
    exit 1
fi

stack_outputs=$(aws cloudformation describe-stacks \
    --region "${AWS_REGION}" \
    --stack-name "${AWS_RUNNER_STACK_NAME}" \
    --query 'Stacks[0].Outputs' \
    --output json)

read_stack_output()
{
    jq --exit-status --raw-output \
        --arg key "$1" \
        '[.[] | select(.OutputKey == $key) | .OutputValue]
         | if length == 1 then .[0] else error("missing or duplicate stack output") end' \
        <<< "${stack_outputs}"
}

contract_version=$(read_stack_output InfrastructureContractVersion)
infrastructure_revision=$(read_stack_output InfrastructureRevision)
runner_role_arn=$(read_stack_output GitHubActionsRoleArn)
production_promotion_role_arn=$(read_stack_output ProductionPromotionRoleArn)
ghcr_publisher_role_arn=$(read_stack_output GhcrPublisherRoleArn)
if [[ ! ${contract_version} =~ ^[1-9][0-9]*$ ||
    ${contract_version} != "${source_contract_version}" ]]; then
    printf 'Deployed contract version %s does not match source version %s.\n' \
        "${contract_version:-<invalid>}" \
        "${source_contract_version}" >&2
    exit 1
fi
if [[ ${infrastructure_revision} != "${source_revision}" ]]; then
    printf 'Deployed infrastructure revision %s does not match source revision %s.\n' \
        "${infrastructure_revision}" \
        "${source_revision}" >&2
    exit 1
fi
if [[ ! ${runner_role_arn} =~ ^arn:(aws|aws-us-gov|aws-cn):iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$ ]]; then
    printf 'Invalid GitHubActionsRoleArn stack output: %s\n' \
        "${runner_role_arn}" >&2
    exit 1
fi
if [[ ! ${production_promotion_role_arn} =~ ^arn:(aws|aws-us-gov|aws-cn):iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$ ]]; then
    printf 'Invalid ProductionPromotionRoleArn stack output: %s\n' \
        "${production_promotion_role_arn}" >&2
    exit 1
fi
if [[ ! ${ghcr_publisher_role_arn} =~ ^arn:(aws|aws-us-gov|aws-cn):iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$ ]]; then
    printf 'Invalid GhcrPublisherRoleArn stack output: %s\n' \
        "${ghcr_publisher_role_arn}" >&2
    exit 1
fi

{
    printf 'contract_version=%s\n' "${contract_version}"
    printf 'infrastructure_revision=%s\n' "${infrastructure_revision}"
    printf 'runner_role_arn=%s\n' "${runner_role_arn}"
    printf 'production_promotion_role_arn=%s\n' "${production_promotion_role_arn}"
    printf 'ghcr_publisher_role_arn=%s\n' "${ghcr_publisher_role_arn}"
} >> "${GITHUB_OUTPUT}"
