#!/usr/bin/env bash

set -euo pipefail

credentials=
installation_id=
region=us-west-2
stack_name=reaveros-github-runners

usage()
{
    printf '%s\n' \
        "usage: $0 --credentials - --installation-id <id>" \
        '    [--region <region>] [--stack-name <name>]'
}

while [[ $# -gt 0 ]]
do
    case $1 in
        --credentials)
            credentials=$2
            shift 2
            ;;
        --installation-id)
            installation_id=$2
            shift 2
            ;;
        --region)
            region=$2
            shift 2
            ;;
        --stack-name)
            stack_name=$2
            shift 2
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
done

if [[ ${credentials} != - || ! ${installation_id} =~ ^[0-9]+$ ]]
then
    printf 'Credentials must be decrypted into standard input.\n' >&2
    usage >&2
    exit 2
fi

credentials_json=$(cat)
app_id=$(jq --exit-status --raw-output '.id | select(type == "number")' \
    <<<"${credentials_json}")
if ! jq --exit-status '.pem | select(type == "string")' \
    <<<"${credentials_json}" >/dev/null
then
    printf 'GitHub App credentials do not contain a private key.\n' >&2
    exit 2
fi

secret_id=$(aws cloudformation describe-stacks \
    --region "${region}" \
    --stack-name "${stack_name}" \
    --query 'Stacks[0].Outputs[?OutputKey==`RunnerAppSecretId`].OutputValue | [0]' \
    --output text)
if [[ -z ${secret_id} || ${secret_id} == None ]]
then
    printf 'RunnerAppSecretId is missing from stack %s.\n' "${stack_name}" >&2
    exit 1
fi

jq \
    --arg installation_id "${installation_id}" \
    '{
        app_id: (.id | tostring),
        installation_id: $installation_id,
        private_key: .pem
    }' \
    <<<"${credentials_json}" \
    | aws secretsmanager put-secret-value \
        --region "${region}" \
        --secret-id "${secret_id}" \
        --secret-string file:///dev/stdin \
        >/dev/null

printf 'Stored App %s installation %s in %s.\n' \
    "${app_id}" "${installation_id}" "${secret_id}"
