#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 2 || -z ${GITHUB_OUTPUT:-} || -z ${GITHUB_STEP_SUMMARY:-} ]]
then
    printf 'usage: %s <template> <change-set-name>\n' "$0" >&2
    exit 2
fi

template=$1
change_set_name=$2

required_environment=(
    AWS_REGION
    AWS_BUDGET_NOTIFICATION_EMAIL
    AWS_CLOUDFORMATION_EXECUTION_ROLE_ARN
    AWS_DEPLOYMENT_ARTIFACT_BUCKET
    AWS_GITHUB_OIDC_PROVIDER_ARN
    AWS_GITHUB_RUNNER_GROUP_ID
    AWS_RUNNER_ROLE_PERMISSIONS_BOUNDARY_ARN
    AWS_RUNNER_STACK_NAME
)

for environment_variable in "${required_environment[@]}"
do
    if [[ -z ${!environment_variable:-} ]]
    then
        printf 'Required environment variable is empty: %s\n' "${environment_variable}" >&2
        exit 2
    fi
done

if [[ ! -f ${template} ]]
then
    printf 'CloudFormation template does not exist: %s\n' "${template}" >&2
    exit 1
fi

if [[ ! ${change_set_name} =~ ^[a-zA-Z][-a-zA-Z0-9]*-[0-9]+-[0-9]+$ \
    || ${change_set_name} != "${AWS_RUNNER_STACK_NAME}-"* ]]
then
    printf 'Invalid change-set name: %s\n' "${change_set_name}" >&2
    exit 2
fi

describe_error=$(mktemp)
packaged_template=$(mktemp --suffix=.yaml)
cleanup()
{
    rm -f "${describe_error}" "${packaged_template}"
}
trap cleanup EXIT

aws cloudformation package \
    --region "${AWS_REGION}" \
    --template-file "${template}" \
    --s3-bucket "${AWS_DEPLOYMENT_ARTIFACT_BUCKET}" \
    --s3-prefix "${AWS_RUNNER_STACK_NAME}" \
    --output-template-file "${packaged_template}" \
    >/dev/null

if stack=$(aws cloudformation describe-stacks \
    --region "${AWS_REGION}" \
    --stack-name "${AWS_RUNNER_STACK_NAME}" \
    --output json \
    2>"${describe_error}")
then
    stack_status=$(jq --exit-status --raw-output '.Stacks[0].StackStatus' <<<"${stack}")
    if [[ ${stack_status} == REVIEW_IN_PROGRESS ]]
    then
        change_set_type=CREATE
    else
        change_set_type=UPDATE
    fi
else
    if ! grep --fixed-strings --quiet 'does not exist' "${describe_error}"
    then
        cat "${describe_error}" >&2
        exit 1
    fi
    stack=
    change_set_type=CREATE
fi

parameters=(
    "ParameterKey=BudgetNotificationEmail,ParameterValue=${AWS_BUDGET_NOTIFICATION_EMAIL}"
    "ParameterKey=GitHubOidcProviderArn,ParameterValue=${AWS_GITHUB_OIDC_PROVIDER_ARN}"
    "ParameterKey=GitHubRunnerGroupId,ParameterValue=${AWS_GITHUB_RUNNER_GROUP_ID}"
    "ParameterKey=RunnerRolePermissionsBoundaryArn,ParameterValue=${AWS_RUNNER_ROLE_PERMISSIONS_BOUNDARY_ARN}"
)

if [[ ${change_set_type} == UPDATE ]]
then
    while read -r parameter
    do
        case ${parameter} in
            BudgetNotificationEmail|GitHubOidcProviderArn|GitHubRunnerGroupId|RunnerRolePermissionsBoundaryArn)
                ;;
            *)
                parameters+=("ParameterKey=${parameter},UsePreviousValue=true")
                ;;
        esac
    done < <(jq --raw-output '.Stacks[0].Parameters[].ParameterKey' <<<"${stack}")
fi

create_arguments=(
    --region "${AWS_REGION}"
    --stack-name "${AWS_RUNNER_STACK_NAME}"
    --change-set-name "${change_set_name}"
    --change-set-type "${change_set_type}"
    --description "GitHub infrastructure revision ${GITHUB_SHA:-unknown}; run ${GITHUB_RUN_ID:-unknown}; attempt ${GITHUB_RUN_ATTEMPT:-unknown}"
    --template-body "file://${packaged_template}"
    --role-arn "${AWS_CLOUDFORMATION_EXECUTION_ROLE_ARN}"
    --capabilities CAPABILITY_IAM
    --parameters "${parameters[@]}"
    --tags "Key=Project,Value=ReaverOS"
)

if [[ ${change_set_type} == CREATE ]]
then
    create_arguments+=(--on-stack-failure DELETE)
fi

aws cloudformation create-change-set "${create_arguments[@]}" >/dev/null

if ! aws cloudformation wait change-set-create-complete \
    --region "${AWS_REGION}" \
    --stack-name "${AWS_RUNNER_STACK_NAME}" \
    --change-set-name "${change_set_name}"
then
    change_set=$(aws cloudformation describe-change-set \
        --region "${AWS_REGION}" \
        --stack-name "${AWS_RUNNER_STACK_NAME}" \
        --change-set-name "${change_set_name}" \
        --output json)
    status=$(jq --raw-output '.Status' <<<"${change_set}")
    reason=$(jq --raw-output '.StatusReason // ""' <<<"${change_set}")
    if [[ ${status} == FAILED ]] \
        && { [[ ${reason} == *"didn't contain changes"* ]] \
            || [[ ${reason} == *"did not contain changes"* ]] \
            || [[ ${reason} == *"No updates are to be performed"* ]]; }
    then
        aws cloudformation delete-change-set \
            --region "${AWS_REGION}" \
            --stack-name "${AWS_RUNNER_STACK_NAME}" \
            --change-set-name "${change_set_name}"
        printf 'has_changes=false\n' >> "${GITHUB_OUTPUT}"
        printf '### AWS infrastructure\n\nNo CloudFormation changes are required.\n' \
            >> "${GITHUB_STEP_SUMMARY}"
        exit 0
    fi

    jq . <<<"${change_set}" >&2
    exit 1
fi

change_set=$(aws cloudformation describe-change-set \
    --region "${AWS_REGION}" \
    --stack-name "${AWS_RUNNER_STACK_NAME}" \
    --change-set-name "${change_set_name}" \
    --output json)
change_set_arn=$(jq --exit-status --raw-output '.ChangeSetId' <<<"${change_set}")

{
    printf 'change_set_arn=%s\n' "${change_set_arn}"
    printf 'change_set_type=%s\n' "${change_set_type}"
    printf 'has_changes=true\n'
} >> "${GITHUB_OUTPUT}"

{
    printf '### AWS infrastructure change set\n\n'
    printf -- '- Stack: `%s`\n' "${AWS_RUNNER_STACK_NAME}"
    printf -- '- Type: `%s`\n\n' "${change_set_type}"
    jq --raw-output '
        .Changes[].ResourceChange
        | "- `\(.Action)` `\(.LogicalResourceId)` (`\(.ResourceType)`), replacement: `\(.Replacement // "n/a")`"
    ' <<<"${change_set}"
} >> "${GITHUB_STEP_SUMMARY}"
