#!/usr/bin/env bash

set -euo pipefail

contract_version=
ci_gate_app_slug=
infrastructure_revision=
maintenance_app_slug=
region=
repository=reaver-project/reaveros
runner_role_arn=
stack_name=

usage()
{
    printf '%s\n' \
        "usage: $0 --contract-version <version> --infrastructure-revision <sha>" \
        '    --ci-gate-app-slug <slug> --maintenance-app-slug <slug>' \
        '    --region <region>' \
        '    --runner-role-arn <arn> --stack-name <name>' \
        '    [--repository <owner/repository>]'
}

while [[ $# -gt 0 ]]; do
    case $1 in
        --contract-version)
            contract_version=$2
            shift 2
            ;;
        --ci-gate-app-slug)
            ci_gate_app_slug=$2
            shift 2
            ;;
        --infrastructure-revision)
            infrastructure_revision=$2
            shift 2
            ;;
        --maintenance-app-slug)
            maintenance_app_slug=$2
            shift 2
            ;;
        --region)
            region=$2
            shift 2
            ;;
        --repository)
            repository=$2
            shift 2
            ;;
        --runner-role-arn)
            runner_role_arn=$2
            shift 2
            ;;
        --stack-name)
            stack_name=$2
            shift 2
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
done

if [[ ! ${contract_version} =~ ^[1-9][0-9]*$ ||
    ! ${ci_gate_app_slug} =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ||
    ! ${infrastructure_revision} =~ ^[0-9a-f]{40}$ ||
    ! ${maintenance_app_slug} =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ||
    ! ${repository} =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ||
    ! ${region} =~ ^[a-z]{2}(-[a-z]+)+-[0-9]+$ ||
    ! ${stack_name} =~ ^[A-Za-z][-A-Za-z0-9]*$ ||
    ! ${runner_role_arn} =~ ^arn:(aws|aws-us-gov|aws-cn):iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$ ]]; then
    usage >&2
    exit 2
fi

set_variable()
{
    gh variable set "$1" --repo "${repository}" --body "$2"
}

set_variable AWS_REGION "${region}"
set_variable AWS_INFRASTRUCTURE_CONTRACT_VERSION "${contract_version}"
set_variable AWS_INFRASTRUCTURE_REVISION "${infrastructure_revision}"
set_variable AWS_RUNNER_ROLE_ARN "${runner_role_arn}"
set_variable AWS_RUNNER_STACK_NAME "${stack_name}"
set_variable CI_GATE_APP_SLUG "${ci_gate_app_slug}"
set_variable MAINTENANCE_APP_SLUG "${maintenance_app_slug}"

printf 'Configured the ReaverOS AWS CI contract for %s.\n' "${repository}"
