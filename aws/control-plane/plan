#!/usr/bin/env bash

set -euo pipefail

self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repository_root=$(git -C "${self_dir}" rev-parse --show-toplevel)
# shellcheck source=aws/local-deployment
source "${repository_root}/aws/local-deployment"

local_profile=
control_plane_stack_name=reaver-project-ci-deployment-trust
default_branch=main
deployment_plan_audit_bucket=
expected_account_id=
access_analyzer_arn=
oidc_provider_arn=
region=us-west-2
repository=reaver-project/infrastructure
organization_config="${repository_root}/aws/organization/reaver-project.json"
github_config="${repository_root}/github/repositories/infrastructure.json"
runner_stack_name=reaveros-github-runners

usage()
{
    printf '%s\n' \
        "usage: $0 [--profile <profile>]" \
        '    --deployment-plan-audit-bucket <bucket>' \
        '    [--region <region>] [--control-plane-stack-name <name>]' \
        '    [--runner-stack-name <name>] [--repository <owner/repository>]' \
        '    [--default-branch <branch>] [--oidc-provider-arn <arn>]' \
        '    [--access-analyzer-arn <arn>]' \
        '    [--organization-config <path>]'
}

while [[ $# -gt 0 ]]; do
    case $1 in
        --access-analyzer-arn)
            access_analyzer_arn=$2
            shift 2
            ;;
        --bootstrap-stack-name | --control-plane-stack-name)
            control_plane_stack_name=$2
            shift 2
            ;;
        --default-branch)
            default_branch=$2
            shift 2
            ;;
        --deployment-plan-audit-bucket)
            deployment_plan_audit_bucket=$2
            shift 2
            ;;
        --organization-config)
            organization_config=$2
            shift 2
            ;;
        --oidc-provider-arn)
            oidc_provider_arn=$2
            shift 2
            ;;
        --profile)
            local_profile=$2
            shift 2
            ;;
        --region)
            region=$2
            shift 2
            ;;
        --repository)
            repository=$2
            shift 2
            ;;
        --runner-stack-name)
            runner_stack_name=$2
            shift 2
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
done

if [[ -z ${deployment_plan_audit_bucket} ]]; then
    usage >&2
    exit 2
fi
expected_account_id=$(organization_account_id "${organization_config}" reaver-project-ci)
oidc_immutable_repository=$(jq --exit-status --raw-output \
    '.oidc_immutable_repository' "${github_config}")
local_require_clean_repository
local_require_account

revision=$(local_repository_revision)
template_sha256=$(local_template_sha256 "${self_dir}/template.yaml")
change_set_name="${control_plane_stack_name}-${revision:0:12}"
plan_workflow_reference="${repository}/.github/workflows/aws-infrastructure.yml@refs/heads/${default_branch}"
deploy_workflow_reference="${repository}/.github/workflows/aws-infrastructure-deploy.yml@refs/heads/${default_branch}"

describe_error=$(mktemp)
create_error=$(mktemp)
cleanup()
{
    rm -f "${describe_error}" "${create_error}"
}
trap cleanup EXIT

if stack=$(local_aws cloudformation describe-stacks \
    --region "${region}" \
    --stack-name "${control_plane_stack_name}" \
    --query 'Stacks[0]' \
    --output json \
    2> "${describe_error}"); then
    stack_status=$(jq --exit-status --raw-output '.StackStatus' <<< "${stack}")
    if [[ ${stack_status} == REVIEW_IN_PROGRESS ]]; then
        change_set_type=CREATE
    else
        change_set_type=UPDATE
    fi
    deployed_revision=$(jq --raw-output \
        '.Outputs[]? | select(.OutputKey == "ControlPlaneRevision") | .OutputValue' \
        <<< "${stack}")
    deployed_template_sha256=$(jq --raw-output \
        '.Outputs[]? | select(.OutputKey == "ControlPlaneTemplateSha256") | .OutputValue' \
        <<< "${stack}")
    stack_parameter()
    {
        jq --raw-output \
            --arg key "$1" \
            '[.Parameters[] | select(.ParameterKey == $key) | .ParameterValue]
             | if length == 1 then .[0] else "<missing-or-duplicate>" end' \
            <<< "${stack}"
    }
    if [[ ${change_set_type} == UPDATE &&
        ${deployed_revision} == "${revision}" &&
        ${deployed_template_sha256} == "${template_sha256}" &&
        $(stack_parameter GitHubDefaultBranch) == "${default_branch}" &&
        $(stack_parameter GitHubOidcImmutableRepository) == "${oidc_immutable_repository}" &&
        $(stack_parameter GitHubOidcPlanWorkflowReference) == "${plan_workflow_reference}" &&
        $(stack_parameter GitHubOidcDeployWorkflowReference) == "${deploy_workflow_reference}" &&
        $(stack_parameter DeploymentPlanAuditLogBucketName) == "${deployment_plan_audit_bucket}" &&
        $(stack_parameter GitHubOidcProviderArn) == "${oidc_provider_arn}" &&
        $(stack_parameter InfrastructureAccessAnalyzerArn) == "${access_analyzer_arn}" &&
        $(stack_parameter RunnerStackName) == "${runner_stack_name}" ]]; then
        printf 'AWS control plane stack %s already matches revision %s.\n' \
            "${control_plane_stack_name}" "${revision}"
        exit
    fi
elif grep --fixed-strings --quiet 'does not exist' "${describe_error}"; then
    change_set_type=CREATE
else
    cat "${describe_error}" >&2
    exit 1
fi

create_arguments=(
    --region "${region}"
    --stack-name "${control_plane_stack_name}"
    --change-set-name "${change_set_name}"
    --change-set-type "${change_set_type}"
    --description "AWS control plane revision ${revision}; template ${template_sha256}"
    --template-body "file://${self_dir}/template.yaml"
    --capabilities CAPABILITY_IAM
    --parameters
    "ParameterKey=ControlPlaneRevision,ParameterValue=${revision}"
    "ParameterKey=ControlPlaneTemplateSha256,ParameterValue=${template_sha256}"
    "ParameterKey=GitHubDefaultBranch,ParameterValue=${default_branch}"
    "ParameterKey=GitHubOidcImmutableRepository,ParameterValue=${oidc_immutable_repository}"
    "ParameterKey=GitHubOidcPlanWorkflowReference,ParameterValue=${plan_workflow_reference}"
    "ParameterKey=GitHubOidcDeployWorkflowReference,ParameterValue=${deploy_workflow_reference}"
    "ParameterKey=DeploymentPlanAuditLogBucketName,ParameterValue=${deployment_plan_audit_bucket}"
    "ParameterKey=GitHubOidcProviderArn,ParameterValue=${oidc_provider_arn}"
    "ParameterKey=InfrastructureAccessAnalyzerArn,ParameterValue=${access_analyzer_arn}"
    "ParameterKey=RunnerStackName,ParameterValue=${runner_stack_name}"
)
if [[ ${change_set_type} == CREATE ]]; then
    create_arguments+=(--on-stack-failure DELETE)
fi

created_change_set=true
if local_aws cloudformation create-change-set "${create_arguments[@]}" \
    > /dev/null 2> "${create_error}"; then
    local_aws cloudformation wait change-set-create-complete \
        --region "${region}" \
        --stack-name "${control_plane_stack_name}" \
        --change-set-name "${change_set_name}"
elif ! grep --fixed-strings --quiet 'AlreadyExists' "${create_error}"; then
    cat "${create_error}" >&2
    exit 1
else
    created_change_set=false
fi

change_set=$(local_aws cloudformation describe-change-set \
    --region "${region}" \
    --stack-name "${control_plane_stack_name}" \
    --change-set-name "${change_set_name}" \
    --query '{ChangeSetId:ChangeSetId,StackName:StackName,ChangeSetName:ChangeSetName,Status:Status,ExecutionStatus:ExecutionStatus,Description:Description,OnStackFailure:OnStackFailure,Parameters:Parameters,Changes:Changes}' \
    --output json)
expected_description="AWS control plane revision ${revision}; template ${template_sha256}"
if [[ $(jq --raw-output '.StackName' <<< "${change_set}") != "${control_plane_stack_name}" ||
$(jq --raw-output '.ChangeSetName' <<< "${change_set}") != "${change_set_name}" ||
$(jq --raw-output '.Status' <<< "${change_set}") != CREATE_COMPLETE ||
$(jq --raw-output '.ExecutionStatus' <<< "${change_set}") != AVAILABLE ||
$(jq --raw-output '.Description' <<< "${change_set}") != "${expected_description}" ]]; then
    printf 'Refusing an unexpected or stale existing AWS control plane change set.\n' >&2
    exit 1
fi
change_set_parameter()
{
    jq --raw-output \
        --arg key "$1" \
        '[.Parameters[] | select(.ParameterKey == $key) | .ParameterValue]
         | if length == 1 then .[0] else "<missing-or-duplicate>" end' \
        <<< "${change_set}"
}
if [[ ${created_change_set} == false ]] &&
    [[ $(change_set_parameter ControlPlaneRevision) != "${revision}" ||
    $(change_set_parameter ControlPlaneTemplateSha256) != "${template_sha256}" ||
    $(change_set_parameter GitHubDefaultBranch) != "${default_branch}" ||
    $(change_set_parameter GitHubOidcImmutableRepository) != "${oidc_immutable_repository}" ||
    $(change_set_parameter GitHubOidcPlanWorkflowReference) != "${plan_workflow_reference}" ||
    $(change_set_parameter GitHubOidcDeployWorkflowReference) != "${deploy_workflow_reference}" ||
    $(change_set_parameter DeploymentPlanAuditLogBucketName) != "${deployment_plan_audit_bucket}" ||
    $(change_set_parameter GitHubOidcProviderArn) != "${oidc_provider_arn}" ||
    $(change_set_parameter InfrastructureAccessAnalyzerArn) != "${access_analyzer_arn}" ||
    $(change_set_parameter RunnerStackName) != "${runner_stack_name}" ]]; then
    printf 'Refusing an existing AWS control plane change set with different parameters.\n' >&2
    exit 1
fi
printf '%s\n' "${change_set}"
