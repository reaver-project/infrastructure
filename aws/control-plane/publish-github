#!/usr/bin/env bash

set -euo pipefail

self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repository_root=$(git -C "${self_dir}" rev-parse --show-toplevel)
# shellcheck source=aws/local-deployment
# shellcheck disable=SC1091
source "${repository_root}/aws/local-deployment"

local_profile=
control_plane_stack_name=reaver-project-ci-deployment-trust
budget_email=
expected_account_id=
organization_config="${repository_root}/aws/organization/reaver-project.json"
reaveros_config="${repository_root}/github/repositories/reaveros.json"
region=us-west-2
repository=reaver-project/infrastructure
runner_group_id=

usage()
{
    printf '%s\n' \
        "usage: $0 [--profile <profile>]" \
        '    --budget-email <email> --runner-group-id <id>' \
        '    [--region <region>] [--control-plane-stack-name <name>]' \
        '    [--repository <owner/repository>]' \
        '    [--organization-config <path>]'
}

while [[ $# -gt 0 ]]; do
    case $1 in
        --bootstrap-stack-name | --control-plane-stack-name)
            control_plane_stack_name=$2
            shift 2
            ;;
        --budget-email)
            budget_email=$2
            shift 2
            ;;
        --organization-config)
            organization_config=$2
            shift 2
            ;;
        --profile)
            local_profile=$2
            shift 2
            ;;
        --region)
            region=$2
            shift 2
            ;;
        --repository)
            repository=$2
            shift 2
            ;;
        --runner-group-id)
            runner_group_id=$2
            shift 2
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
done

if [[ -z ${budget_email} || ! ${runner_group_id} =~ ^[0-9]+$ ]]; then
    usage >&2
    exit 2
fi
expected_account_id=$(organization_account_id "${organization_config}" reaver-project-ci)
export expected_account_id local_profile
local_require_clean_repository
local_require_account

revision=$(local_repository_revision)
template_sha256=$(local_template_sha256 "${self_dir}/template.yaml")

control_plane_stack=$(local_aws cloudformation describe-stacks \
    --region "${region}" \
    --stack-name "${control_plane_stack_name}" \
    --query 'Stacks[0]' \
    --output json)
stack_status=$(jq --exit-status --raw-output '.StackStatus' <<< "${control_plane_stack}")
if [[ ! ${stack_status} =~ ^(CREATE|UPDATE)_COMPLETE$ ]]; then
    printf 'Refusing to publish outputs from incomplete control-plane stack %s.\n' \
        "${control_plane_stack_name}" >&2
    exit 1
fi

stack_output()
{
    jq --exit-status --raw-output \
        --arg key "$1" \
        '.Outputs[] | select(.OutputKey == $key) | .OutputValue' \
        <<< "${control_plane_stack}"
}

if [[ $(stack_output ControlPlaneRevision) != "${revision}" ||
$(stack_output ControlPlaneTemplateSha256) != "${template_sha256}" ]]; then
    printf 'Refusing outputs from a control-plane stack built from another revision.\n' >&2
    exit 1
fi

export AWS_BUDGET_NOTIFICATION_EMAIL=${budget_email}
export AWS_CLOUDFORMATION_EXECUTION_ROLE_ARN
AWS_CLOUDFORMATION_EXECUTION_ROLE_ARN=$(stack_output CloudFormationExecutionRoleArn)
export AWS_CONTROL_PLANE_DEPLOY_ROLE_ARN
AWS_CONTROL_PLANE_DEPLOY_ROLE_ARN=$(stack_output ControlPlaneDeployRoleArn)
export AWS_CONTROL_PLANE_EXECUTION_ROLE_ARN
AWS_CONTROL_PLANE_EXECUTION_ROLE_ARN=$(stack_output ControlPlaneCloudFormationExecutionRoleArn)
export AWS_CONTROL_PLANE_PLAN_ROLE_ARN
AWS_CONTROL_PLANE_PLAN_ROLE_ARN=$(stack_output ControlPlanePlanRoleArn)
export AWS_CONTROL_PLANE_STACK_NAME
AWS_CONTROL_PLANE_STACK_NAME=$(stack_output ControlPlaneStackName)
export AWS_DEPLOYMENT_ARTIFACT_BUCKET
AWS_DEPLOYMENT_ARTIFACT_BUCKET=$(stack_output DeploymentArtifactBucketName)
export AWS_DEPLOYMENT_PLAN_AUDIT_BUCKET
AWS_DEPLOYMENT_PLAN_AUDIT_BUCKET=$(stack_output DeploymentPlanAuditLogBucketName)
export AWS_GITHUB_OIDC_PROVIDER_ARN
AWS_GITHUB_OIDC_PROVIDER_ARN=$(stack_output GitHubOidcProviderArn)
export AWS_GITHUB_OIDC_REPOSITORY_SUBJECT_PATTERN
AWS_GITHUB_OIDC_REPOSITORY_SUBJECT_PATTERN=$(jq --exit-status --raw-output \
    '.oidc_immutable_repository_pattern' "${reaveros_config}")
export AWS_GITHUB_RUNNER_GROUP_ID=${runner_group_id}
export AWS_INFRASTRUCTURE_DEPLOY_ROLE_ARN
AWS_INFRASTRUCTURE_DEPLOY_ROLE_ARN=$(stack_output InfrastructureDeployRoleArn)
export AWS_INFRASTRUCTURE_ACCESS_ANALYZER_ARN
AWS_INFRASTRUCTURE_ACCESS_ANALYZER_ARN=$(stack_output InfrastructureAccessAnalyzerArn)
export AWS_INFRASTRUCTURE_PLAN_ROLE_ARN
AWS_INFRASTRUCTURE_PLAN_ROLE_ARN=$(stack_output InfrastructurePlanRoleArn)
export AWS_REGION=${region}
export AWS_RUNNER_ROLE_PERMISSIONS_BOUNDARY_ARN
AWS_RUNNER_ROLE_PERMISSIONS_BOUNDARY_ARN=$(stack_output RunnerRolePermissionsBoundaryArn)
export AWS_RUNNER_STACK_NAME
AWS_RUNNER_STACK_NAME=$(stack_output RunnerStackName)
export GITHUB_REPOSITORY=${repository}

"${self_dir}/publish-github-values"

printf 'Published AWS control plane outputs from %s to %s.\n' \
    "${control_plane_stack_name}" \
    "${repository}"
