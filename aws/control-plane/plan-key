#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 5 ]]; then
    printf 'usage: %s <repository> <revision> <run-id> <run-attempt> <stack-name>\n' \
        "$0" >&2
    exit 2
fi

repository=$1
revision=$2
run_id=$3
run_attempt=$4
stack_name=$5

if [[ ! ${repository} =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ||
    ! ${revision} =~ ^[0-9a-f]{40}$ ||
    ! ${run_id} =~ ^[1-9][0-9]*$ ||
    ! ${run_attempt} =~ ^[1-9][0-9]*$ ||
    ! ${stack_name} =~ ^[A-Za-z][-A-Za-z0-9]*$ ]]; then
    printf 'Invalid control-plane plan identity.\n' >&2
    exit 2
fi

digest=$(printf '%s\0%s\0%s\0%s\0%s\0' \
    "${repository}" \
    "${revision}" \
    "${run_id}" \
    "${run_attempt}" \
    "${stack_name}" |
    sha256sum |
    cut -d ' ' -f 1)
printf 'plans/control-plane/%s.json\n' "${digest}"
