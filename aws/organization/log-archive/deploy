#!/usr/bin/env bash

set -euo pipefail

self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repository_root=$(git -C "${self_dir}" rev-parse --show-toplevel)
# shellcheck source=aws/local-deployment
source "${repository_root}/aws/local-deployment"

mode=${1:-}
if [[ ${mode} == plan || ${mode} == apply ]]; then
    shift
else
    mode=
fi

local_profile=
local_stack_name=reaver-project-central-audit
ci_control_plane_stack_name=reaver-project-ci-deployment-trust
expected_account_id=
organization_config="${repository_root}/aws/organization/reaver-project.json"
region=us-west-2

usage()
{
    printf '%s\n' \
        "usage: $0 <plan|apply> --profile <profile>" \
        '    [--ci-control-plane-stack-name <name>]' \
        '    [--organization-config <path>]' \
        '    [--region <region>] [--stack-name <name>]'
}

while [[ $# -gt 0 ]]; do
    case $1 in
        --ci-control-plane-stack-name)
            ci_control_plane_stack_name=$2
            shift 2
            ;;
        --organization-config)
            organization_config=$2
            shift 2
            ;;
        --profile)
            local_profile=$2
            shift 2
            ;;
        --region)
            region=$2
            shift 2
            ;;
        --stack-name)
            local_stack_name=$2
            shift 2
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
done

if [[ -z ${mode} ]]; then
    usage >&2
    exit 2
fi
expected_account_id=$(organization_account_id \
    "${organization_config}" \
    reaver-project-log-archive)
ci_account_id=$(organization_account_id "${organization_config}" reaver-project-ci)
local_require_clean_repository
local_require_account

revision=$(local_repository_revision)
template_sha256=$(local_template_sha256 "${self_dir}/template.yaml")
change_set_name="${local_stack_name}-${revision:0:12}"

if [[ ${mode} == plan ]]; then
    describe_error=$(mktemp)
    create_error=$(mktemp)
    # shellcheck disable=SC2329 # Invoked by the EXIT trap.
    cleanup()
    {
        rm -f "${describe_error}" "${create_error}"
    }
    trap cleanup EXIT

    if stack=$(local_aws cloudformation describe-stacks \
        --region "${region}" \
        --stack-name "${local_stack_name}" \
        --query 'Stacks[0]' \
        --output json \
        2> "${describe_error}"); then
        stack_status=$(jq --exit-status --raw-output '.StackStatus' <<< "${stack}")
        if [[ ${stack_status} == REVIEW_IN_PROGRESS ]]; then
            change_set_type=CREATE
        else
            change_set_type=UPDATE
        fi
        deployed_revision=$(jq --raw-output \
            '.Outputs[]? | select(.OutputKey == "InfrastructureRevision") | .OutputValue' \
            <<< "${stack}")
        deployed_template_sha256=$(jq --raw-output \
            '.Outputs[]? | select(.OutputKey == "TemplateSha256") | .OutputValue' \
            <<< "${stack}")
        stack_parameter()
        {
            jq --raw-output \
                --arg key "$1" \
                '[.Parameters[] | select(.ParameterKey == $key) | .ParameterValue]
                 | if length == 1 then .[0] else "<missing-or-duplicate>" end' \
                <<< "${stack}"
        }
        if [[ ${change_set_type} == UPDATE &&
            ${deployed_revision} == "${revision}" &&
            ${deployed_template_sha256} == "${template_sha256}" &&
            $(stack_parameter CiAccountId) == "${ci_account_id}" &&
            $(stack_parameter CiControlPlaneStackName) == "${ci_control_plane_stack_name}" ]]; then
            printf 'Central audit stack %s already matches revision %s.\n' \
                "${local_stack_name}" "${revision}"
            exit
        fi
    elif grep --fixed-strings --quiet 'does not exist' "${describe_error}"; then
        change_set_type=CREATE
    else
        cat "${describe_error}" >&2
        exit 1
    fi

    create_arguments=(
        --region "${region}"
        --stack-name "${local_stack_name}"
        --change-set-name "${change_set_name}"
        --change-set-type "${change_set_type}"
        --description "Central audit storage revision ${revision}; template ${template_sha256}"
        --template-body "file://${self_dir}/template.yaml"
        --parameters
        "ParameterKey=InfrastructureRevision,ParameterValue=${revision}"
        "ParameterKey=TemplateSha256,ParameterValue=${template_sha256}"
        "ParameterKey=CiAccountId,ParameterValue=${ci_account_id}"
        "ParameterKey=CiControlPlaneStackName,ParameterValue=${ci_control_plane_stack_name}"
    )
    if [[ ${change_set_type} == CREATE ]]; then
        create_arguments+=(--on-stack-failure DELETE)
    fi
    created_change_set=true
    if local_aws cloudformation create-change-set "${create_arguments[@]}" \
        > /dev/null 2> "${create_error}"; then
        local_aws cloudformation wait change-set-create-complete \
            --region "${region}" \
            --stack-name "${local_stack_name}" \
            --change-set-name "${change_set_name}"
    elif ! grep --fixed-strings --quiet 'AlreadyExists' "${create_error}"; then
        cat "${create_error}" >&2
        exit 1
    else
        created_change_set=false
    fi

    change_set=$(local_aws cloudformation describe-change-set \
        --region "${region}" \
        --stack-name "${local_stack_name}" \
        --change-set-name "${change_set_name}" \
        --output json)
    expected_description="Central audit storage revision ${revision}; template ${template_sha256}"
    if [[ $(jq --raw-output '.StackName' <<< "${change_set}") != "${local_stack_name}" ||
    $(jq --raw-output '.ChangeSetName' <<< "${change_set}") != "${change_set_name}" ||
    $(jq --raw-output '.Status' <<< "${change_set}") != CREATE_COMPLETE ||
    $(jq --raw-output '.ExecutionStatus' <<< "${change_set}") != AVAILABLE ||
    $(jq --raw-output '.Description' <<< "${change_set}") != "${expected_description}" ]]; then
        printf 'Refusing an unexpected or stale existing central-audit change set.\n' >&2
        exit 1
    fi
    change_set_parameter()
    {
        jq --raw-output \
            --arg key "$1" \
            '[.Parameters[] | select(.ParameterKey == $key) | .ParameterValue]
             | if length == 1 then .[0] else "<missing-or-duplicate>" end' \
            <<< "${change_set}"
    }
    if [[ ${created_change_set} == false ]] &&
        [[ $(change_set_parameter InfrastructureRevision) != "${revision}" ||
        $(change_set_parameter TemplateSha256) != "${template_sha256}" ||
        $(change_set_parameter CiAccountId) != "${ci_account_id}" ||
        $(change_set_parameter CiControlPlaneStackName) != "${ci_control_plane_stack_name}" ]]; then
        printf 'Refusing an existing central-audit change set with different parameters.\n' >&2
        exit 1
    fi
    printf '%s\n' "${change_set}"
    exit
fi

change_set=$(local_aws cloudformation describe-change-set \
    --region "${region}" \
    --stack-name "${local_stack_name}" \
    --change-set-name "${change_set_name}" \
    --output json)
stack_name=$(jq --exit-status --raw-output '.StackName' <<< "${change_set}")
resolved_change_set_name=$(jq --exit-status --raw-output '.ChangeSetName' <<< "${change_set}")
on_stack_failure=$(jq --raw-output '.OnStackFailure // empty' <<< "${change_set}")
case ${on_stack_failure} in
    DELETE)
        change_set_type=CREATE
        ;;
    '')
        change_set_type=UPDATE
        ;;
    *)
        printf 'Refusing a central-audit change set with unexpected failure behavior.\n' >&2
        exit 1
        ;;
esac
status=$(jq --exit-status --raw-output '.Status' <<< "${change_set}")
execution_status=$(jq --exit-status --raw-output '.ExecutionStatus' <<< "${change_set}")
description=$(jq --exit-status --raw-output '.Description' <<< "${change_set}")
if [[ ${stack_name} != "${local_stack_name}" ||
    ${resolved_change_set_name} != "${change_set_name}" ||
    ${status} != CREATE_COMPLETE ||
    ${execution_status} != AVAILABLE ||
    ${description} != "Central audit storage revision ${revision}; template ${template_sha256}" ]]; then
    printf 'Refusing an unexpected or stale central-audit change set.\n' >&2
    exit 1
fi

local_aws cloudformation execute-change-set \
    --region "${region}" \
    --stack-name "${local_stack_name}" \
    --change-set-name "${change_set_name}" \
    --client-request-token "local-${revision}" \
    > /dev/null
case ${change_set_type} in
    CREATE)
        waiter='stack-create-complete'
        ;;
    UPDATE)
        waiter='stack-update-complete'
        ;;
esac
local_aws cloudformation wait "${waiter}" \
    --region "${region}" \
    --stack-name "${local_stack_name}"
local_aws cloudformation update-termination-protection \
    --region "${region}" \
    --stack-name "${local_stack_name}" \
    --enable-termination-protection \
    > /dev/null
stack_outputs=$(local_aws cloudformation describe-stacks \
    --region "${region}" \
    --stack-name "${local_stack_name}" \
    --query 'Stacks[0].Outputs' \
    --output json)
output_value()
{
    jq --exit-status --raw-output \
        --arg key "$1" \
        '.[] | select(.OutputKey == $key) | .OutputValue' \
        <<< "${stack_outputs}"
}
if [[ $(output_value InfrastructureRevision) != "${revision}" ||
$(output_value TemplateSha256) != "${template_sha256}" ]]; then
    printf 'Central audit stack outputs do not match the applied revision.\n' >&2
    exit 1
fi
printf '%s\n' "${stack_outputs}"
