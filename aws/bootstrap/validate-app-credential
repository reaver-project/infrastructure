#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 1 ]]; then
    printf 'usage: %s <runner|ci-gate>\n' "$0" >&2
    exit 2
fi

credential=$(cat)
common_filter='
    def decimal_string:
        type == "string" and test("^[1-9][0-9]*$");
    def private_key:
        type == "string"
        and test("^-----BEGIN (RSA )?PRIVATE KEY-----\\n")
        and test("\\n-----END (RSA )?PRIVATE KEY-----\\n?$");
'

case $1 in
    runner)
        credential_filter="${common_filter}"'
            type == "object"
            and (keys | sort == ["app_id", "installation_id", "private_key"])
            and (.app_id | decimal_string)
            and (.installation_id | decimal_string)
            and (.private_key | private_key)
        '
        ;;
    ci-gate)
        credential_filter="${common_filter}"'
            type == "object"
            and (keys | sort == ["app_id", "app_slug", "private_key", "webhook_secret"])
            and (.app_id | decimal_string)
            and (.app_slug
                | type == "string"
                and test("^[a-z0-9]+(-[a-z0-9]+)*$"))
            and (.private_key | private_key)
            and (.webhook_secret | type == "string" and length >= 32)
        '
        ;;
    *)
        printf 'Unknown App credential kind: %s\n' "$1" >&2
        exit 2
        ;;
esac

if ! jq --exit-status "${credential_filter}" \
    <<< "${credential}" > /dev/null 2>&1; then
    exit 1
fi

jq --exit-status --raw-output '.private_key' <<< "${credential}" 2> /dev/null |
    openssl rsa -check -noout > /dev/null 2>&1
