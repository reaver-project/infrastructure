#!/usr/bin/env bash

set -euo pipefail

self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
validator="${self_dir}/validate-app-credential"
private_key=$(openssl genpkey \
    -algorithm RSA \
    -pkeyopt rsa_keygen_bits:2048 \
    2> /dev/null)
private_key_label='RSA PRIVATE KEY'
invalid_private_key=$(printf -- \
    '-----BEGIN %s-----\ntest-key-material\n-----END %s-----\n' \
    "${private_key_label}" \
    "${private_key_label}")
webhook_secret=$(printf 'x%.0s' {1..32})

runner_credential=$(jq --null-input \
    --arg private_key "${private_key}" \
    '{
        app_id: "4961957",
        installation_id: "162110798",
        private_key: $private_key
    }')
ci_gate_credential=$(jq --null-input \
    --arg private_key "${private_key}" \
    --arg webhook_secret "${webhook_secret}" \
    '{
        app_id: "4962000",
        app_slug: "reaver-project-ci-gate",
        private_key: $private_key,
        webhook_secret: $webhook_secret
    }')

printf '%s\n' "${runner_credential}" | "${validator}" runner
printf '%s\n' "${ci_gate_credential}" | "${validator}" ci-gate

reject()
{
    local kind=$1
    local value=$2

    if printf '%s\n' "${value}" | "${validator}" "${kind}"; then
        printf 'Accepted invalid %s App credential.\n' "${kind}" >&2
        exit 1
    fi
}

reject runner generated-placeholder
reject runner '{}'
reject runner "$(jq '.installation_id = ""' <<< "${runner_credential}")"
reject runner "$(jq '.unexpected = true' <<< "${runner_credential}")"
reject runner "$(jq --arg private_key "${invalid_private_key}" \
    '.private_key = $private_key' <<< "${runner_credential}")"
reject ci-gate '{}'
reject ci-gate "$(jq '.webhook_secret = "too-short"' <<< "${ci_gate_credential}")"
reject ci-gate "$(jq '.app_slug = "Not A Slug"' <<< "${ci_gate_credential}")"
reject ci-gate "$(jq 'del(.private_key)' <<< "${ci_gate_credential}")"

if printf '{}\n' | "${validator}" unknown > /dev/null 2>&1; then
    printf 'Accepted an unknown App credential kind.\n' >&2
    exit 1
fi
