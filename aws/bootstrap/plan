#!/usr/bin/env bash

set -euo pipefail

self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repository_root=$(git -C "${self_dir}" rev-parse --show-toplevel)
# shellcheck source=aws/bootstrap/common
source "${self_dir}/common"

bootstrap_profile=
bootstrap_stack_name=reaver-project-ci-deployment-trust
default_branch=main
expected_account_id=
access_analyzer_arn=
oidc_provider_arn=
region=us-west-2
repository=reaver-project/infrastructure
organization_config="${repository_root}/aws/organization/reaver-project.json"
runner_stack_name=reaveros-github-runners

usage()
{
    printf '%s\n' \
        "usage: $0 --profile <profile>" \
        '    [--region <region>] [--bootstrap-stack-name <name>]' \
        '    [--runner-stack-name <name>] [--repository <owner/repository>]' \
        '    [--default-branch <branch>] [--oidc-provider-arn <arn>]' \
        '    [--access-analyzer-arn <arn>]' \
        '    [--organization-config <path>]'
}

while [[ $# -gt 0 ]]; do
    case $1 in
        --access-analyzer-arn)
            access_analyzer_arn=$2
            shift 2
            ;;
        --bootstrap-stack-name)
            bootstrap_stack_name=$2
            shift 2
            ;;
        --default-branch)
            default_branch=$2
            shift 2
            ;;
        --organization-config)
            organization_config=$2
            shift 2
            ;;
        --oidc-provider-arn)
            oidc_provider_arn=$2
            shift 2
            ;;
        --profile)
            bootstrap_profile=$2
            shift 2
            ;;
        --region)
            region=$2
            shift 2
            ;;
        --repository)
            repository=$2
            shift 2
            ;;
        --runner-stack-name)
            runner_stack_name=$2
            shift 2
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
done

expected_account_id=$(bootstrap_account_id "${organization_config}" reaver-project-ci)
bootstrap_require_clean_repository
bootstrap_require_account

revision=$(bootstrap_repository_revision)
template_sha256=$(bootstrap_template_sha256 "${self_dir}/template.yaml")
change_set_name="${bootstrap_stack_name}-${revision:0:12}"
plan_workflow_reference="${repository}/.github/workflows/aws-infrastructure.yml@refs/heads/${default_branch}"
deploy_workflow_reference="${repository}/.github/workflows/aws-infrastructure-deploy.yml@refs/heads/${default_branch}"

describe_error=$(mktemp)
create_error=$(mktemp)
cleanup()
{
    rm -f "${describe_error}" "${create_error}"
}
trap cleanup EXIT

if stack=$(bootstrap_aws cloudformation describe-stacks \
    --region "${region}" \
    --stack-name "${bootstrap_stack_name}" \
    --query 'Stacks[0]' \
    --output json \
    2> "${describe_error}"); then
    change_set_type=UPDATE
    deployed_revision=$(jq --raw-output \
        '.Outputs[] | select(.OutputKey == "BootstrapRevision") | .OutputValue' \
        <<< "${stack}")
    deployed_template_sha256=$(jq --raw-output \
        '.Outputs[] | select(.OutputKey == "BootstrapTemplateSha256") | .OutputValue' \
        <<< "${stack}")
    if [[ ${deployed_revision} == "${revision}" &&
        ${deployed_template_sha256} == "${template_sha256}" ]]; then
        printf 'CI bootstrap stack %s already matches revision %s.\n' \
            "${bootstrap_stack_name}" "${revision}"
        exit
    fi
elif grep --fixed-strings --quiet 'does not exist' "${describe_error}"; then
    change_set_type=CREATE
else
    cat "${describe_error}" >&2
    exit 1
fi

create_arguments=(
    --region "${region}"
    --stack-name "${bootstrap_stack_name}"
    --change-set-name "${change_set_name}"
    --change-set-type "${change_set_type}"
    --description "CI bootstrap revision ${revision}; template ${template_sha256}"
    --template-body "file://${self_dir}/template.yaml"
    --capabilities CAPABILITY_IAM
    --parameters
    "ParameterKey=BootstrapRevision,ParameterValue=${revision}"
    "ParameterKey=BootstrapTemplateSha256,ParameterValue=${template_sha256}"
    "ParameterKey=GitHubDefaultBranch,ParameterValue=${default_branch}"
    "ParameterKey=GitHubOidcPlanWorkflowReference,ParameterValue=${plan_workflow_reference}"
    "ParameterKey=GitHubOidcDeployWorkflowReference,ParameterValue=${deploy_workflow_reference}"
    "ParameterKey=GitHubOidcProviderArn,ParameterValue=${oidc_provider_arn}"
    "ParameterKey=InfrastructureAccessAnalyzerArn,ParameterValue=${access_analyzer_arn}"
    "ParameterKey=RunnerStackName,ParameterValue=${runner_stack_name}"
)
if [[ ${change_set_type} == CREATE ]]; then
    create_arguments+=(--on-stack-failure DELETE)
fi

if bootstrap_aws cloudformation create-change-set "${create_arguments[@]}" \
    > /dev/null 2> "${create_error}"; then
    bootstrap_aws cloudformation wait change-set-create-complete \
        --region "${region}" \
        --stack-name "${bootstrap_stack_name}" \
        --change-set-name "${change_set_name}"
elif ! grep --fixed-strings --quiet 'AlreadyExists' "${create_error}"; then
    cat "${create_error}" >&2
    exit 1
fi

change_set=$(bootstrap_aws cloudformation describe-change-set \
    --region "${region}" \
    --stack-name "${bootstrap_stack_name}" \
    --change-set-name "${change_set_name}" \
    --query '{ChangeSetId:ChangeSetId,StackName:StackName,ChangeSetName:ChangeSetName,Status:Status,ExecutionStatus:ExecutionStatus,Description:Description,OnStackFailure:OnStackFailure,Parameters:Parameters,Changes:Changes}' \
    --output json)
expected_description="CI bootstrap revision ${revision}; template ${template_sha256}"
if [[ $(jq --raw-output '.StackName' <<< "${change_set}") != "${bootstrap_stack_name}" ||
$(jq --raw-output '.ChangeSetName' <<< "${change_set}") != "${change_set_name}" ||
$(jq --raw-output '.Status' <<< "${change_set}") != CREATE_COMPLETE ||
$(jq --raw-output '.ExecutionStatus' <<< "${change_set}") != AVAILABLE ||
$(jq --raw-output '.Description' <<< "${change_set}") != "${expected_description}" ]]; then
    printf 'Refusing an unexpected or stale existing CI bootstrap change set.\n' >&2
    exit 1
fi
printf '%s\n' "${change_set}"
