#!/usr/bin/env bash

set -euo pipefail

test_root=$(mktemp -d)
cleanup()
{
    rm -rf -- "${test_root}"
}
trap cleanup EXIT

mock_bin=${test_root}/bin
mkdir -p "${mock_bin}"
export CFN_GUARD_TEST_LOG=${test_root}/commands.log
export REAVER_PROJECT_TOOL_CACHE=${test_root}/cache
export PATH=${mock_bin}:/usr/bin:/bin

cat > "${mock_bin}/uname" << 'EOF'
#!/usr/bin/env bash
if [[ $1 == -s ]]; then
    printf '%s\n' "${CFN_GUARD_TEST_OS:-Linux}"
elif [[ $1 == -m ]]; then
    printf '%s\n' "${CFN_GUARD_TEST_ARCH:-x86_64}"
fi
EOF

cat > "${mock_bin}/curl" << 'EOF'
#!/usr/bin/env bash
printf 'curl\t%s\n' "$*" >> "${CFN_GUARD_TEST_LOG}"
while [[ $# -gt 0 ]]; do
    if [[ $1 == --output ]]; then
        printf 'archive\n' > "$2"
        exit
    fi
    shift
done
exit 2
EOF

cat > "${mock_bin}/sha256sum" << 'EOF'
#!/usr/bin/env bash
printf 'sha256sum\t%s\n' "$*" >> "${CFN_GUARD_TEST_LOG}"
exit "${CFN_GUARD_TEST_SHA_STATUS:-0}"
EOF

cat > "${mock_bin}/shasum" << 'EOF'
#!/usr/bin/env bash
printf 'shasum\t%s\n' "$*" >> "${CFN_GUARD_TEST_LOG}"
printf '%s  %s\n' \
    "${CFN_GUARD_TEST_SHASUM:-6eb1d1693471499d47e453567a7d46f17171468ec31ff2aa98b91116b316b5c4}" \
    "${!#}"
EOF

cat > "${mock_bin}/tar" << 'EOF'
#!/usr/bin/env bash
printf 'tar\t%s\n' "$*" >> "${CFN_GUARD_TEST_LOG}"
while [[ $# -gt 0 ]]; do
    if [[ $1 == --directory ]]; then
        destination=$2
        break
    fi
    shift
done
cat > "${destination}/cfn-guard" <<'INNER_EOF'
#!/usr/bin/env bash
printf 'guard\t%s\n' "$*" >> "${CFN_GUARD_TEST_LOG}"
INNER_EOF
chmod +x "${destination}/cfn-guard"
EOF

chmod +x "${mock_bin}"/*

aws/cfn-guard validate --data template.yaml
grep -F $'curl\t' "${CFN_GUARD_TEST_LOG}" > /dev/null
grep -F 'cfn-guard-v3-x86_64-linux-latest.tar.gz' "${CFN_GUARD_TEST_LOG}" > /dev/null
grep -F $'sha256sum\t--check --status' "${CFN_GUARD_TEST_LOG}" > /dev/null
grep -F $'guard\tvalidate --data template.yaml' "${CFN_GUARD_TEST_LOG}" > /dev/null

: > "${CFN_GUARD_TEST_LOG}"
aws/cfn-guard test --rules-file rules.guard
test "$(wc -l < "${CFN_GUARD_TEST_LOG}")" -eq 1
grep -F $'guard\ttest --rules-file rules.guard' "${CFN_GUARD_TEST_LOG}" > /dev/null

export REAVER_PROJECT_TOOL_CACHE=${test_root}/macos-cache
export CFN_GUARD_TEST_OS=Darwin
export CFN_GUARD_TEST_ARCH=arm64
: > "${CFN_GUARD_TEST_LOG}"
aws/cfn-guard validate --data template.yaml
grep -F 'cfn-guard-v3-aarch64-macos-latest.tar.gz' "${CFN_GUARD_TEST_LOG}" > /dev/null
grep -F $'shasum\t-a 256' "${CFN_GUARD_TEST_LOG}" > /dev/null

export REAVER_PROJECT_TOOL_CACHE=${test_root}/invalid-macos-cache
export CFN_GUARD_TEST_SHASUM=invalid
if aws/cfn-guard validate --data template.yaml 2> /dev/null; then
    printf 'cfn-guard accepted an invalid macOS release digest.\n' >&2
    exit 1
fi
test ! -e "${REAVER_PROJECT_TOOL_CACHE}/cfn-guard/3.2.0/cfn-guard"
unset CFN_GUARD_TEST_SHASUM

export REAVER_PROJECT_TOOL_CACHE=${test_root}/invalid-cache
export CFN_GUARD_TEST_OS=Linux
export CFN_GUARD_TEST_ARCH=x86_64
export CFN_GUARD_TEST_SHA_STATUS=1
if aws/cfn-guard validate --data template.yaml 2> /dev/null; then
    printf 'cfn-guard accepted an invalid release digest.\n' >&2
    exit 1
fi
test ! -e "${REAVER_PROJECT_TOOL_CACHE}/cfn-guard/3.2.0/cfn-guard"

export REAVER_PROJECT_TOOL_CACHE=${test_root}/unsupported-cache
export CFN_GUARD_TEST_SHA_STATUS=0
export CFN_GUARD_TEST_ARCH=riscv64
if aws/cfn-guard validate --data template.yaml 2> "${test_root}/unsupported.log"; then
    printf 'cfn-guard accepted an unsupported platform.\n' >&2
    exit 1
fi
grep -F 'has no pinned binary for Linux:riscv64' "${test_root}/unsupported.log" > /dev/null
