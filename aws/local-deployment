#!/usr/bin/env bash

# shellcheck disable=SC2154 # Callers define the local deployment context before use.

local_aws()
{
    if [[ -n ${local_profile} ]]; then
        aws --profile "${local_profile}" "$@"
    else
        aws "$@"
    fi
}

local_repository_revision()
{
    git -C "${repository_root}" rev-parse HEAD
}

local_require_clean_repository()
{
    if [[ -n $(git -C "${repository_root}" status --porcelain --untracked-files=all) ]]; then
        printf 'Refusing to plan or apply from a dirty infrastructure worktree.\n' >&2
        exit 1
    fi
}

local_template_sha256()
{
    sha256sum "$1" | cut --delimiter=' ' --fields=1
}

organization_account_id()
{
    local config=$1
    local account_name=$2
    jq --exit-status --raw-output \
        --arg account_name "${account_name}" \
        '.accounts[] | select(.name == $account_name) | .account_id' \
        "${config}"
}

local_require_account()
{
    if [[ ! ${expected_account_id} =~ ^[0-9]{12}$ ]]; then
        printf 'A configured twelve-digit account ID is required.\n' >&2
        exit 2
    fi

    local actual_account_id
    actual_account_id=$(local_aws sts get-caller-identity \
        --query Account \
        --output text)
    if [[ ${actual_account_id} != "${expected_account_id}" ]]; then
        printf 'Refusing local infrastructure operation in unexpected AWS account %s.\n' \
            "${actual_account_id}" >&2
        exit 1
    fi
}
