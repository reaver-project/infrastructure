#!/usr/bin/env bash

set -euo pipefail

configuration=

usage()
{
    printf 'usage: %s <repository-config.json>\n' "$0"
}

if [[ $# -ne 1 ]]; then
    usage >&2
    exit 2
fi
configuration=$1

if [[ ! -f ${configuration} ]]; then
    usage >&2
    exit 2
fi

repository=$(jq --exit-status --raw-output '.repository' "${configuration}")
default_branch=$(jq --exit-status --raw-output '.default_branch' "${configuration}")

github_api()
{
    gh api \
        --header 'Accept: application/vnd.github+json' \
        --header 'X-GitHub-Api-Version: 2026-03-10' \
        "$@"
}

jq --compact-output '.profile | del(.visibility)' "${configuration}" |
    github_api --method PATCH "repos/${repository}" --input - > /dev/null

jq --compact-output '.actions | {enabled, allowed_actions, sha_pinning_required}' \
    "${configuration}" |
    github_api --method PUT \
        "repos/${repository}/actions/permissions" \
        --input - \
        > /dev/null

jq --compact-output '.actions | {
    default_workflow_permissions,
    can_approve_pull_request_reviews
}' "${configuration}" |
    github_api --method PUT \
        "repos/${repository}/actions/permissions/workflow" \
        --input - \
        > /dev/null

action_access=$(jq --raw-output '.action_access // empty' "${configuration}")
if [[ -n ${action_access} ]]; then
    jq --null-input --compact-output --arg access_level "${action_access}" \
        '{access_level: $access_level}' |
        github_api --method PUT \
            "repos/${repository}/actions/permissions/access" \
            --input - \
            > /dev/null
fi

jq --compact-output '{
    use_default: false,
    use_immutable_subject: .oidc_use_immutable_subject,
    include_claim_keys: .oidc_subject_claims
}' "${configuration}" |
    github_api --method PUT \
        "repos/${repository}/actions/oidc/customization/sub" \
        --input - \
        > /dev/null

existing_rulesets=$(github_api --paginate \
    "repos/${repository}/rulesets?includes_parents=false" \
    --jq '.[] | [.id, .name] | @tsv')
while IFS= read -r ruleset; do
    name=$(jq --exit-status --raw-output '.name' <<< "${ruleset}")
    while IFS= read -r actor_id_variable; do
        actor_id=${!actor_id_variable:-}
        if [[ ! ${actor_id} =~ ^[1-9][0-9]*$ ]]; then
            printf 'Ruleset %s requires numeric environment variable %s.\n' \
                "${name}" "${actor_id_variable}" >&2
            exit 2
        fi
        ruleset=$(jq --compact-output \
            --arg variable "${actor_id_variable}" \
            --argjson actor_id "${actor_id}" \
            '(.bypass_actors[] | select(.actor_id_variable == $variable)) |=
                (del(.actor_id_variable) + {actor_id: $actor_id})' \
            <<< "${ruleset}")
    done < <(jq --raw-output '.bypass_actors[].actor_id_variable // empty' \
        <<< "${ruleset}")
    ruleset_id=$(awk -F $'\t' -v name="${name}" '$2 == name {print $1; exit}' \
        <<< "${existing_rulesets}")
    if [[ -n ${ruleset_id} ]]; then
        method=PUT
        endpoint="repos/${repository}/rulesets/${ruleset_id}"
    else
        method=POST
        endpoint="repos/${repository}/rulesets"
    fi
    jq --compact-output . <<< "${ruleset}" |
        github_api --method "${method}" "${endpoint}" --input - > /dev/null
done < <(jq --compact-output '.rulesets[]' "${configuration}")

# Protect the default branch before making the repository public. Settings
# available only to public repositories are converged immediately afterward.
visibility=$(jq --raw-output '.profile.visibility // empty' "${configuration}")
if [[ -n ${visibility} ]]; then
    jq --null-input --compact-output --arg visibility "${visibility}" \
        '{visibility: $visibility}' |
        github_api --method PATCH "repos/${repository}" --input - > /dev/null
fi

fork_approval=$(jq --raw-output '.fork_pull_request_approval // empty' "${configuration}")
if [[ -n ${fork_approval} ]]; then
    jq --null-input --compact-output --arg approval_policy "${fork_approval}" \
        '{approval_policy: $approval_policy}' |
        github_api --method PUT \
            "repos/${repository}/actions/permissions/fork-pr-contributor-approval" \
            --input - \
            > /dev/null
fi

reviewer_type=$(jq --raw-output '.environment_reviewer.type // empty' "${configuration}")
reviewer_id=
if jq --exit-status 'any(.environments[]; .required_reviewer)' \
    "${configuration}" > /dev/null; then
    case ${reviewer_type} in
        Team)
            reviewer_slug=$(jq --exit-status --raw-output \
                '.environment_reviewer.slug' "${configuration}")
            organization=${repository%%/*}
            reviewer_id=$(github_api \
                "orgs/${organization}/teams/${reviewer_slug}" \
                --jq '.id')
            ;;
        User)
            reviewer_login=$(jq --exit-status --raw-output \
                '.environment_reviewer.login' "${configuration}")
            reviewer_id=$(github_api "users/${reviewer_login}" --jq '.id')
            ;;
        *)
            printf 'A valid environment reviewer is required by %s.\n' \
                "${configuration}" >&2
            exit 2
            ;;
    esac
fi

while IFS= read -r environment; do
    name=$(jq --exit-status --raw-output '.name' <<< "${environment}")
    branch=$(jq --exit-status --raw-output '.branch' <<< "${environment}")
    required_reviewer=$(jq --raw-output '.required_reviewer' <<< "${environment}")
    reviewers='[]'
    if [[ ${required_reviewer} == true ]]; then
        reviewers=$(jq --null-input --compact-output \
            --arg reviewer_type "${reviewer_type}" \
            --argjson reviewer_id "${reviewer_id}" \
            '[{type: $reviewer_type, id: $reviewer_id}]')
    fi
    jq --null-input --compact-output \
        --argjson reviewers "${reviewers}" \
        '{
            can_admins_bypass: false,
            prevent_self_review: false,
            reviewers: $reviewers,
            deployment_branch_policy: {
                protected_branches: false,
                custom_branch_policies: true
            }
        }' |
        github_api --method PUT \
            "repos/${repository}/environments/${name}" \
            --input - \
            > /dev/null

    branch_policies=$(github_api --paginate \
        "repos/${repository}/environments/${name}/deployment-branch-policies" \
        --jq '.branch_policies[] | [.id, .name, .type] | @tsv')
    found_branch=false
    while IFS=$'\t' read -r policy_id policy_name policy_type; do
        if [[ -z ${policy_id} ]]; then
            continue
        fi
        if [[ ${policy_name} == "${branch}" && ${policy_type} == branch ]]; then
            found_branch=true
        else
            github_api --method DELETE \
                "repos/${repository}/environments/${name}/deployment-branch-policies/${policy_id}" \
                > /dev/null
        fi
    done <<< "${branch_policies}"

    if [[ ${found_branch} == false ]]; then
        jq --null-input --compact-output --arg name "${branch}" \
            '{name: $name, type: "branch"}' |
            github_api --method POST \
                "repos/${repository}/environments/${name}/deployment-branch-policies" \
                --input - \
                > /dev/null
    fi
done < <(jq --compact-output '.environments[]' "${configuration}")

printf 'Converged GitHub repository settings for %s at %s.\n' \
    "${repository}" "${default_branch}"
