#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 0 || -z ${GH_TOKEN:-} ||
    ! ${GITHUB_RUN_ID:-} =~ ^[1-9][0-9]*$ ||
    ! ${GITHUB_RUN_ATTEMPT:-} =~ ^[1-9][0-9]*$ ]]; then
    printf 'The signing probe needs an App token and a GitHub run identity.\n' >&2
    exit 2
fi

repository=reaver-project/reaveros
probe_id=${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}
base_branch=maintenance/signing-probe/${probe_id}-base
head_branch=maintenance/signing-probe/${probe_id}-head
base_created=false
head_created=false

cleanup()
{
    if ${head_created}; then
        gh api --method DELETE \
            "repos/${repository}/git/refs/heads/${head_branch}" > /dev/null 2>&1 || true
    fi
    if ${base_created}; then
        gh api --method DELETE \
            "repos/${repository}/git/refs/heads/${base_branch}" > /dev/null 2>&1 || true
    fi
}
trap cleanup EXIT

base_revision=$(gh api "repos/${repository}/git/ref/heads/main" --jq '.object.sha')
if [[ ! ${base_revision} =~ ^[0-9a-f]{40}$ ]]; then
    printf 'ReaverOS main does not identify a full commit.\n' >&2
    exit 1
fi

gh api "repos/${repository}/git/refs" --method POST \
    --field ref="refs/heads/${base_branch}" --field sha="${base_revision}" > /dev/null
base_created=true
gh api "repos/${repository}/git/refs" --method POST \
    --field ref="refs/heads/${head_branch}" --field sha="${base_revision}" > /dev/null
head_created=true

mutation='mutation($input: CreateCommitOnBranchInput!) { createCommitOnBranch(input: $input) { commit { oid signature { isValid wasSignedByGitHub signer { login } } } } }'
contents=$(printf 'Maintenance App squash signing probe %s\n' "${probe_id}" | base64 --wrap=0)
response=$(jq --null-input \
    --arg query "${mutation}" \
    --arg repository "${repository}" \
    --arg branch "${head_branch}" \
    --arg base "${base_revision}" \
    --arg contents "${contents}" \
    '{query: $query, variables: {input: {
        branch: {repositoryNameWithOwner: $repository, branchName: $branch},
        expectedHeadOid: $base,
        message: {headline: "Probe Maintenance App squash signing"},
        fileChanges: {additions: [{path: "maintenance/signing-probe.txt", contents: $contents}]}
    }}}' | gh api graphql --input -)
head_revision=$(jq --exit-status --raw-output \
    '.data.createCommitOnBranch.commit
        | select(.signature.isValid == true and .signature.wasSignedByGitHub == true)
        | .oid | select(test("^[0-9a-f]{40}$"))' <<< "${response}")
if [[ $(gh api "repos/${repository}/commits/${head_revision}" \
    --jq '[.author.login, .commit.verification.verified] | join(" ")') != 'reaver-project-maintenance[bot] true' ]]; then
    printf 'Maintenance App did not author a verified probe commit.\n' >&2
    exit 1
fi

gh pr create --repo "${repository}" \
    --base "${base_branch}" --head "${head_branch}" \
    --title "Probe Maintenance App squash signing ${probe_id}" \
    --body 'Temporary isolated branch test of GitHub-signed App squash merging.' \
    > /dev/null
pull_request_number=$(gh pr list --repo "${repository}" \
    --base "${base_branch}" --head "${head_branch}" --state open \
    --json number --jq '.[0].number // empty')
if [[ ! ${pull_request_number} =~ ^[1-9][0-9]*$ ]]; then
    printf 'Could not find the signing probe pull request.\n' >&2
    exit 1
fi

gh pr merge "${pull_request_number}" --repo "${repository}" \
    --auto --squash --match-head-commit "${head_revision}"

merge_revision=
for _ in {1..20}; do
    merge_revision=$(gh pr view "${pull_request_number}" --repo "${repository}" \
        --json state,mergeCommit \
        --jq 'select(.state == "MERGED") | .mergeCommit.oid // empty')
    if [[ ${merge_revision} =~ ^[0-9a-f]{40}$ ]]; then
        break
    fi
    sleep 2
done
if [[ ! ${merge_revision} =~ ^[0-9a-f]{40}$ ]]; then
    printf 'The signing probe pull request did not merge promptly.\n' >&2
    exit 1
fi

verified_merge=$(gh api "repos/${repository}/commits/${merge_revision}" \
    --jq '[.commit.verification.verified, .parents[0].sha] | join(" ")')
if [[ ${verified_merge} != "true ${base_revision}" ||
    $(gh api "repos/${repository}/git/ref/heads/${base_branch}" \
        --jq '.object.sha') != "${merge_revision}" ]]; then
    printf 'The Maintenance App squash did not produce a verified base commit.\n' >&2
    exit 1
fi

printf 'Maintenance App squash merge %s was GitHub-verified.\n' "${merge_revision}"
