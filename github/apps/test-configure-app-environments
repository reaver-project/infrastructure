#!/usr/bin/env bash

set -euo pipefail

if [[ $(basename -- "$0") == gh ]]; then
    {
        printf 'gh'
        printf '\t%s' "$@"
        printf '\n'
    } >> "${APP_TEST_LOG}"
    if [[ $1 == secret && $2 == set ]]; then
        secret=$(cat)
        if [[ ${secret} != test-private-key ]]; then
            printf 'Unexpected private key on standard input.\n' >&2
            exit 1
        fi
    fi
    exit
fi

self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
test_directory=$(mktemp -d)
mkdir "${test_directory}/bin"
ln -s "${self_dir}/test-configure-app-environments" \
    "${test_directory}/bin/gh"
export PATH="${test_directory}/bin:${PATH}"
export APP_TEST_LOG="${test_directory}/calls"
: > "${APP_TEST_LOG}"
credentials="${test_directory}/credentials.json"
jq --null-input \
    --arg client_id Iv23testclient \
    --argjson id 1234 \
    --arg pem test-private-key \
    '{client_id: $client_id, id: $id, pem: $pem}' > "${credentials}"

cleanup()
{
    rm -rf "${test_directory}"
}
trap cleanup EXIT

"${self_dir}/configure-infrastructure-app" \
    --credentials - \
    < "${credentials}" \
    > /dev/null
"${self_dir}/configure-maintenance-app" \
    --credentials - \
    < "${credentials}" \
    > /dev/null
"${self_dir}/configure-maintenance-app" \
    --credentials - \
    --environment github-production \
    --repository reaver-project/infrastructure \
    < "${credentials}" \
    > /dev/null

assert_log_contains()
{
    if ! grep --fixed-strings --quiet "$1" "${APP_TEST_LOG}"; then
        printf 'Expected App configuration log to contain: %s\n' "$1" >&2
        cat "${APP_TEST_LOG}" >&2
        exit 1
    fi
}

assert_log_contains $'gh\tapi\trepos/reaver-project/infrastructure/environments/github-production'
assert_log_contains $'gh\tvariable\tset\tINFRASTRUCTURE_APP_ID\t--repo\treaver-project/infrastructure\t--env\tgithub-production\t--body\t1234'
assert_log_contains $'gh\tvariable\tset\tINFRASTRUCTURE_APP_CLIENT_ID\t--repo\treaver-project/infrastructure\t--env\tgithub-production\t--body\tIv23testclient'
assert_log_contains $'gh\tsecret\tset\tINFRASTRUCTURE_APP_PRIVATE_KEY\t--repo\treaver-project/infrastructure\t--env\tgithub-production'
assert_log_contains $'gh\tapi\trepos/reaver-project/reaveros/environments/maintenance'
assert_log_contains $'gh\tvariable\tset\tMAINTENANCE_APP_ID\t--repo\treaver-project/reaveros\t--env\tmaintenance\t--body\t1234'
assert_log_contains $'gh\tvariable\tset\tMAINTENANCE_APP_CLIENT_ID\t--repo\treaver-project/reaveros\t--env\tmaintenance\t--body\tIv23testclient'
assert_log_contains $'gh\tsecret\tset\tMAINTENANCE_APP_PRIVATE_KEY\t--repo\treaver-project/reaveros\t--env\tmaintenance'
assert_log_contains $'gh\tvariable\tset\tMAINTENANCE_APP_ID\t--repo\treaver-project/infrastructure\t--env\tgithub-production\t--body\t1234'
assert_log_contains $'gh\tvariable\tset\tMAINTENANCE_APP_CLIENT_ID\t--repo\treaver-project/infrastructure\t--env\tgithub-production\t--body\tIv23testclient'
assert_log_contains $'gh\tsecret\tset\tMAINTENANCE_APP_PRIVATE_KEY\t--repo\treaver-project/infrastructure\t--env\tgithub-production'

printf 'App environment configuration tests passed.\n'
