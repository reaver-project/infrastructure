#!/usr/bin/env node

const crypto = require("crypto");
const fs = require("fs");


function usage() {
    console.error(
        "usage: configure-runner-group --credentials - "
        + "[--organization <name>] [--group <name>] [--repository <owner/name>] "
        + "[--workflow <workflow-reference>]",
    );
}


function parse_arguments(arguments) {
    const options = {
        group: "reaveros",
        organization: "reaver-project",
        repositories: [],
        workflows: [],
    };
    for (let index = 0; index < arguments.length; index += 2) {
        const option = arguments[index];
        const value = arguments[index + 1];
        if (value === undefined) {
            usage();
            process.exit(2);
        }
        switch (option) {
            case "--credentials":
                options.credentials = value;
                break;
            case "--group":
                options.group = value;
                break;
            case "--organization":
                options.organization = value;
                break;
            case "--repository":
                options.repositories.push(value);
                break;
            case "--workflow":
                options.workflows.push(value);
                break;
            default:
                usage();
                process.exit(2);
        }
    }
    if (options.credentials === undefined || options.repositories.length === 0
        || options.workflows.length === 0) {
        usage();
        process.exit(2);
    }
    return options;
}


function base64_url(value) {
    return Buffer.from(value).toString("base64url");
}


function app_jwt(credentials) {
    const now = Math.floor(Date.now() / 1000);
    const header = base64_url(JSON.stringify({alg: "RS256", typ: "JWT"}));
    const payload = base64_url(JSON.stringify({
        exp: now + 540,
        iat: now - 60,
        iss: credentials.id,
    }));
    const unsigned_token = `${header}.${payload}`;
    const signature = crypto.sign(
        "RSA-SHA256",
        Buffer.from(unsigned_token),
        credentials.pem,
    ).toString("base64url");
    return `${unsigned_token}.${signature}`;
}


async function github_request(path, token, method = "GET", body) {
    const response = await fetch(`https://api.github.com${path}`, {
        method,
        headers: {
            Accept: "application/vnd.github+json",
            Authorization: `Bearer ${token}`,
            "User-Agent": "reaver-project-infrastructure-bootstrap",
            "X-GitHub-Api-Version": "2022-11-28",
        },
        body: body === undefined ? undefined : JSON.stringify(body),
    });
    if (!response.ok) {
        throw new Error(
            `GitHub ${method} ${path} failed: ${response.status} ${await response.text()}`,
        );
    }
    if (response.status === 204) {
        return undefined;
    }
    return response.json();
}


async function all_pages(path, token, select_items, request = github_request) {
    const separator = path.includes("?") ? "&" : "?";
    const items = [];
    for (let page = 1; ; ++page) {
        const response = await request(`${path}${separator}per_page=100&page=${page}`, token);
        const page_items = select_items(response);
        items.push(...page_items);
        if (page_items.length < 100) {
            return items;
        }
    }
}


async function installation_token(
    credentials,
    organization,
    request = github_request,
    create_jwt = app_jwt,
) {
    const jwt = create_jwt(credentials);
    const installations = await all_pages(
        "/app/installations",
        jwt,
        response => response,
        request,
    );
    const installation = installations.find(
        candidate => candidate.account.login.toLowerCase() === organization.toLowerCase(),
    );
    if (installation === undefined) {
        throw new Error(`App is not installed in ${organization}`);
    }
    const response = await request(
        `/app/installations/${installation.id}/access_tokens`,
        jwt,
        "POST",
        {},
    );
    return {installation_id: installation.id, token: response.token};
}


async function configure_runner_group(
    options,
    credentials,
    request = github_request,
    create_jwt = app_jwt,
) {
    const installation = await installation_token(
        credentials,
        options.organization,
        request,
        create_jwt,
    );
    const token = installation.token;
    const groups = await all_pages(
        `/orgs/${options.organization}/actions/runner-groups`,
        token,
        response => response.runner_groups,
        request,
    );
    let group = groups.find(candidate => candidate.name === options.group);
    const configuration = {
        allows_public_repositories: true,
        name: options.group,
        restricted_to_workflows: true,
        selected_workflows: options.workflows,
        visibility: "selected",
    };
    if (group === undefined) {
        group = await request(
            `/orgs/${options.organization}/actions/runner-groups`,
            token,
            "POST",
            configuration,
        );
    } else {
        group = await request(
            `/orgs/${options.organization}/actions/runner-groups/${group.id}`,
            token,
            "PATCH",
            configuration,
        );
    }

    const repositories = await Promise.all(options.repositories.map(
        repository => request(`/repos/${repository}`, token),
    ));
    await request(
        `/orgs/${options.organization}/actions/runner-groups/${group.id}/repositories`,
        token,
        "PUT",
        {selected_repository_ids: repositories.map(repository => repository.id)},
    );
    return {
        installation_id: installation.installation_id,
        runner_group_id: group.id,
    };
}


async function main() {
    const options = parse_arguments(process.argv.slice(2));
    if (options.credentials !== "-") {
        throw new Error("credentials must be decrypted into standard input");
    }
    const credentials = JSON.parse(fs.readFileSync(0, "utf8"));
    console.log(JSON.stringify(await configure_runner_group(options, credentials)));
}


if (require.main === module) {
    main().catch(error => {
        console.error(error.message);
        process.exit(1);
    });
}


module.exports = {
    all_pages,
    configure_runner_group,
    parse_arguments,
};
