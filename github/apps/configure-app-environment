#!/usr/bin/env bash

set -euo pipefail

app_id_variable=
credentials=
environment=
private_key_secret=
repository=

usage()
{
    printf '%s\n' \
        "usage: $0 --credentials - --repository <owner/repository>" \
        '    --environment <name> --app-id-variable <name>' \
        '    --private-key-secret <name>'
}

while [[ $# -gt 0 ]]
do
    case $1 in
        --app-id-variable)
            app_id_variable=$2
            shift 2
            ;;
        --credentials)
            credentials=$2
            shift 2
            ;;
        --environment)
            environment=$2
            shift 2
            ;;
        --private-key-secret)
            private_key_secret=$2
            shift 2
            ;;
        --repository)
            repository=$2
            shift 2
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
done

if [[ ${credentials} != - \
    || ! ${repository} =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ \
    || ! ${environment} =~ ^[A-Za-z0-9_.-]+$ \
    || ! ${app_id_variable} =~ ^[A-Z][A-Z0-9_]*$ \
    || ! ${private_key_secret} =~ ^[A-Z][A-Z0-9_]*$ ]]
then
    printf 'Invalid App environment configuration.\n' >&2
    usage >&2
    exit 2
fi

credentials_json=$(cat)
app_id=$(jq --exit-status --raw-output \
    '.id | select(type == "number")' <<<"${credentials_json}")
private_key=$(jq --exit-status --raw-output \
    '.pem | select(type == "string" and length > 0)' <<<"${credentials_json}")

if ! gh api "repos/${repository}/environments/${environment}" >/dev/null
then
    printf '%s\n' \
        "Environment ${environment} does not exist in ${repository}." \
        'Converge its repository configuration before installing App credentials.' >&2
    exit 1
fi

gh variable set "${app_id_variable}" \
    --repo "${repository}" \
    --env "${environment}" \
    --body "${app_id}"
printf '%s' "${private_key}" \
    | gh secret set "${private_key_secret}" \
        --repo "${repository}" \
        --env "${environment}"

printf 'Configured App %s for %s environment %s.\n' \
    "${app_id}" \
    "${repository}" \
    "${environment}"
