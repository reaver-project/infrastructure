#!/usr/bin/env python3

import argparse
import getpass
import html
import http.server
import json
import os
import pathlib
import secrets
import shutil
import subprocess
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
import webbrowser


def parse_arguments():
    parser = argparse.ArgumentParser(
        description="Create an organization-owned GitHub App from a manifest."
    )
    parser.add_argument("manifest", type=pathlib.Path)
    parser.add_argument("--organization", default="reaver-project")
    parser.add_argument(
        "--output",
        required=True,
        type=pathlib.Path,
        help="encrypted credential bundle on a private tmpfs or ramfs directory",
    )
    parser.add_argument("--port", default=8976, type=int)
    parser.add_argument(
        "--webhook-url",
        help="activate the App webhook at this HTTPS endpoint",
    )
    return parser.parse_args()


def configured_manifest(manifest, webhook_url=None):
    manifest = dict(manifest)
    if webhook_url is None:
        return manifest
    parsed = urllib.parse.urlparse(webhook_url)
    if parsed.scheme != "https" or not parsed.netloc or parsed.username is not None:
        raise ValueError("webhook URL must be an absolute HTTPS URL")
    manifest["hook_attributes"] = {
        "active": True,
        "url": webhook_url,
    }
    return manifest


def memory_filesystem(path):
    stat = shutil.which("stat")
    if stat is None:
        raise RuntimeError("stat is required")
    result = subprocess.run(  # noqa: S603 - path is passed as a separate argument.
        [stat, "--file-system", "--format=%T", path],
        check=True,
        capture_output=True,
        text=True,
    )
    return result.stdout.strip() in {"ramfs", "tmpfs"}


def encrypt_credentials(path, credentials, passphrase):
    path = path.resolve()
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if not memory_filesystem(path.parent):
        raise ValueError(f"credential output is not memory-backed: {path.parent}")
    if path.parent.stat().st_mode & 0o077:
        raise ValueError(f"credential directory is not private: {path.parent}")

    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    gpg_home = tempfile.mkdtemp(prefix=".gnupg-", dir=path.parent)
    try:
        passphrase_reader, passphrase_writer = os.pipe()
        try:
            os.write(passphrase_writer, passphrase.encode())
        finally:
            os.close(passphrase_writer)
        try:
            gpg = shutil.which("gpg")
            if gpg is None:
                raise RuntimeError("gpg is required")
            subprocess.run(  # noqa: S603 - fixed gpg command with isolated descriptors.
                [
                    gpg,
                    "--batch",
                    "--quiet",
                    "--no-options",
                    "--homedir",
                    gpg_home,
                    "--pinentry-mode",
                    "loopback",
                    "--no-symkey-cache",
                    "--cipher-algo",
                    "AES256",
                    "--passphrase-fd",
                    str(passphrase_reader),
                    "--symmetric",
                ],
                check=True,
                input=(json.dumps(credentials, separators=(",", ":")) + "\n").encode(),
                pass_fds=(passphrase_reader,),
                stdout=descriptor,
            )
        finally:
            os.close(passphrase_reader)
    except Exception:
        path.unlink(missing_ok=True)
        raise
    finally:
        os.close(descriptor)
        shutil.rmtree(gpg_home)


def exchange_manifest_code(code):
    request = urllib.request.Request(
        f"https://api.github.com/app-manifests/{code}/conversions",
        data=b"",
        method="POST",
        headers={
            "Accept": "application/vnd.github+json",
            "User-Agent": "reaver-project-infrastructure-bootstrap",
            "X-GitHub-Api-Version": "2026-03-10",
        },
    )
    with urllib.request.urlopen(  # noqa: S310 - request URL is fixed to GitHub HTTPS.
        request,
        timeout=30,
    ) as response:
        return json.load(response)


def request_log_line(method, target, request_version, code, size):
    path = urllib.parse.urlsplit(target).path or "/"
    return f'"{method} {path} {request_version}" {code} {size}'


def main():
    arguments = parse_arguments()
    passphrase = getpass.getpass("Credential bundle passphrase: ")
    confirmation = getpass.getpass("Confirm passphrase: ")
    if not passphrase or passphrase != confirmation:
        raise SystemExit("Passphrases are empty or do not match.")
    manifest = configured_manifest(
        json.loads(arguments.manifest.read_text(encoding="utf-8")),
        arguments.webhook_url,
    )
    state = secrets.token_urlsafe(32)
    redirect_url = f"http://127.0.0.1:{arguments.port}/callback"
    manifest["redirect_url"] = redirect_url
    form_action = (
        "https://github.com/organizations/"
        f"{urllib.parse.quote(arguments.organization, safe='')}"
        f"/settings/apps/new?state={urllib.parse.quote(state, safe='')}"
    )
    manifest_json = json.dumps(manifest, separators=(",", ":"))
    result = {"done": False, "error": None}

    class Handler(http.server.BaseHTTPRequestHandler):
        def send_html(self, status, body):
            encoded_body = body.encode("utf-8")
            self.send_response(status)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(encoded_body)))
            self.end_headers()
            self.wfile.write(encoded_body)

        def do_GET(self):
            parsed = urllib.parse.urlparse(self.path)
            if parsed.path == "/":
                self.send_html(
                    200,
                    "<!doctype html><title>Create GitHub App</title>"
                    "<h1>Create GitHub App</h1>"
                    f'<form action="{html.escape(form_action)}" method="post">'
                    f'<input type="hidden" name="manifest" value="{html.escape(manifest_json)}">'
                    '<button type="submit">Review and create the App</button></form>',
                )
                return

            if parsed.path != "/callback":
                self.send_error(404)
                return

            query = urllib.parse.parse_qs(parsed.query)
            if query.get("state") != [state] or len(query.get("code", [])) != 1:
                result["error"] = "GitHub returned an invalid manifest callback."
                result["done"] = True
                self.send_html(400, "<h1>Invalid manifest callback</h1>")
                return

            try:
                credentials = exchange_manifest_code(query["code"][0])
                encrypt_credentials(arguments.output, credentials, passphrase)
            except (OSError, urllib.error.URLError, ValueError) as error:
                result["error"] = str(error)
                self.send_html(500, "<h1>Could not save the App credentials</h1>")
            else:
                self.send_html(
                    200,
                    "<h1>GitHub App created</h1>"
                    "<p>The encrypted credentials were saved. Install the App into the "
                    "organization, then close this tab.</p>",
                )
            finally:
                result["done"] = True

        def log_request(self, code="-", size="-"):
            print(
                request_log_line(
                    self.command,
                    self.path,
                    self.request_version,
                    code,
                    size,
                ),
                file=sys.stderr,
            )

    server = http.server.HTTPServer(("127.0.0.1", arguments.port), Handler)
    bootstrap_url = f"http://127.0.0.1:{arguments.port}/"
    print(f"Open {bootstrap_url} to begin the GitHub App manifest flow.")
    webbrowser.open(bootstrap_url)
    while not result["done"]:
        server.handle_request()
    server.server_close()

    if result["error"] is not None:
        raise SystemExit(result["error"])
    print(f"Saved encrypted GitHub App credentials to {arguments.output.resolve()}.")


if __name__ == "__main__":
    main()
