{
    "name": "Reaver Project CI gate",
    "url": "https://github.com/reaver-project/infrastructure",
    "description": "Copies explicitly trusted pull request revisions onto protected CI branches.",
    "public": false,
    "default_permissions": {
        "contents": "write",
        "issues": "write",
        "pull_requests": "read"
    },
    "default_events": [
        "issue_comment",
        "pull_request"
    ]
}
