{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://reaver-project.org/schemas/control-plane-plan.schema.json",
    "title": "Reaver Project private AWS control-plane plan",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "target",
        "change_set_arn",
        "repository",
        "run_attempt",
        "run_id",
        "source_revision",
        "stack_name",
        "template_sha256"
    ],
    "properties": {
        "schema_version": {
            "const": 1
        },
        "target": {
            "const": "control-plane"
        },
        "change_set_arn": {
            "type": "string",
            "pattern": "^arn:(aws|aws-us-gov|aws-cn):cloudformation:[a-z0-9-]+:[0-9]{12}:changeSet/[A-Za-z][-A-Za-z0-9]*/[A-Za-z0-9-]+$"
        },
        "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "run_attempt": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
        },
        "run_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
        },
        "source_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
        },
        "stack_name": {
            "type": "string",
            "pattern": "^[A-Za-z][-A-Za-z0-9]*$"
        },
        "template_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        }
    }
}
