{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://reaver-project.org/schemas/github-organization.schema.json",
    "title": "Reaver Project GitHub organization desired state",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "organization",
        "profile",
        "actions",
        "code_security",
        "manual_controls"
    ],
    "properties": {
        "organization": {
            "$ref": "#/$defs/name"
        },
        "profile": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "default_repository_permission",
                "deploy_keys_enabled_for_repositories",
                "members_can_create_private_repositories",
                "members_can_create_public_repositories",
                "members_can_create_repositories",
                "web_commit_signoff_required"
            ],
            "properties": {
                "default_repository_permission": {
                    "enum": [
                        "none",
                        "read",
                        "write",
                        "admin"
                    ]
                },
                "deploy_keys_enabled_for_repositories": {
                    "type": "boolean"
                },
                "members_can_create_private_repositories": {
                    "type": "boolean"
                },
                "members_can_create_public_repositories": {
                    "type": "boolean"
                },
                "members_can_create_repositories": {
                    "type": "boolean"
                },
                "web_commit_signoff_required": {
                    "type": "boolean"
                }
            }
        },
        "actions": {
            "$ref": "#/$defs/actions"
        },
        "code_security": {
            "$ref": "#/$defs/code_security"
        },
        "manual_controls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1
            }
        }
    },
    "$defs": {
        "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "actions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "allowed_actions",
                "artifact_and_log_retention_days",
                "can_approve_pull_request_reviews",
                "default_workflow_permissions",
                "enabled_repositories",
                "github_owned_allowed",
                "patterns_allowed",
                "sha_pinning_required",
                "verified_allowed"
            ],
            "properties": {
                "allowed_actions": {
                    "enum": [
                        "all",
                        "local_only",
                        "selected"
                    ]
                },
                "artifact_and_log_retention_days": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 400
                },
                "can_approve_pull_request_reviews": {
                    "type": "boolean"
                },
                "default_workflow_permissions": {
                    "enum": [
                        "read",
                        "write"
                    ]
                },
                "enabled_repositories": {
                    "enum": [
                        "all",
                        "none",
                        "selected"
                    ]
                },
                "github_owned_allowed": {
                    "type": "boolean"
                },
                "patterns_allowed": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "sha_pinning_required": {
                    "type": "boolean"
                },
                "verified_allowed": {
                    "type": "boolean"
                }
            }
        },
        "code_security": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "attachment_scope",
                "default_for_new_repositories",
                "configuration"
            ],
            "properties": {
                "attachment_scope": {
                    "enum": [
                        "all",
                        "all_without_configurations",
                        "public",
                        "private_or_internal"
                    ]
                },
                "default_for_new_repositories": {
                    "enum": [
                        "all",
                        "none",
                        "private_and_internal",
                        "public"
                    ]
                },
                "configuration": {
                    "$ref": "#/$defs/code_security_configuration"
                }
            }
        },
        "code_security_configuration": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "description",
                "code_security",
                "dependency_graph",
                "dependency_graph_autosubmit_action",
                "dependency_graph_autosubmit_action_options",
                "dependabot_alerts",
                "dependabot_security_updates",
                "dependabot_delegated_alert_dismissal",
                "code_scanning_default_setup",
                "code_scanning_default_setup_options",
                "code_scanning_options",
                "code_scanning_delegated_alert_dismissal",
                "secret_protection",
                "secret_scanning",
                "secret_scanning_push_protection",
                "secret_scanning_delegated_bypass",
                "secret_scanning_validity_checks",
                "secret_scanning_non_provider_patterns",
                "secret_scanning_generic_secrets",
                "secret_scanning_delegated_alert_dismissal",
                "secret_scanning_extended_metadata",
                "private_vulnerability_reporting",
                "enforcement"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "description": {
                    "type": "string",
                    "minLength": 1
                },
                "code_security": {
                    "$ref": "#/$defs/feature_status"
                },
                "dependency_graph": {
                    "$ref": "#/$defs/feature_status"
                },
                "dependency_graph_autosubmit_action": {
                    "$ref": "#/$defs/feature_status"
                },
                "dependency_graph_autosubmit_action_options": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "labeled_runners"
                    ],
                    "properties": {
                        "labeled_runners": {
                            "type": "boolean"
                        }
                    }
                },
                "dependabot_alerts": {
                    "$ref": "#/$defs/feature_status"
                },
                "dependabot_security_updates": {
                    "$ref": "#/$defs/feature_status"
                },
                "dependabot_delegated_alert_dismissal": {
                    "$ref": "#/$defs/feature_status"
                },
                "code_scanning_default_setup": {
                    "$ref": "#/$defs/feature_status"
                },
                "code_scanning_default_setup_options": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "runner_type",
                        "runner_label"
                    ],
                    "properties": {
                        "runner_type": {
                            "enum": [
                                "standard",
                                "labeled",
                                "not_set"
                            ]
                        },
                        "runner_label": {
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    }
                },
                "code_scanning_options": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "allow_advanced"
                    ],
                    "properties": {
                        "allow_advanced": {
                            "type": "boolean"
                        }
                    }
                },
                "code_scanning_delegated_alert_dismissal": {
                    "$ref": "#/$defs/feature_status"
                },
                "secret_protection": {
                    "$ref": "#/$defs/feature_status"
                },
                "secret_scanning": {
                    "$ref": "#/$defs/feature_status"
                },
                "secret_scanning_push_protection": {
                    "$ref": "#/$defs/feature_status"
                },
                "secret_scanning_delegated_bypass": {
                    "$ref": "#/$defs/feature_status"
                },
                "secret_scanning_validity_checks": {
                    "$ref": "#/$defs/feature_status"
                },
                "secret_scanning_non_provider_patterns": {
                    "$ref": "#/$defs/feature_status"
                },
                "secret_scanning_generic_secrets": {
                    "$ref": "#/$defs/feature_status"
                },
                "secret_scanning_delegated_alert_dismissal": {
                    "$ref": "#/$defs/feature_status"
                },
                "secret_scanning_extended_metadata": {
                    "$ref": "#/$defs/feature_status"
                },
                "private_vulnerability_reporting": {
                    "$ref": "#/$defs/feature_status"
                },
                "enforcement": {
                    "enum": [
                        "enforced",
                        "unenforced"
                    ]
                }
            }
        },
        "feature_status": {
            "enum": [
                "enabled",
                "disabled",
                "not_set"
            ]
        }
    }
}
