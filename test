#!/usr/bin/env bash

set -euo pipefail

while IFS= read -r variable; do
    unset "${variable}"
done < <(git rev-parse --local-env-vars)

shell_scripts=(
    actions/aws-stack-contract/read
    actions/ephemeral-runner/launch
    actions/ephemeral-runner/terminate
    actions/test
    aws/bootstrap/apply
    aws/bootstrap/audit-completion
    aws/bootstrap/plan
    aws/bootstrap/publish-github
    aws/bootstrap/test
    aws/control-plane/apply
    aws/control-plane/plan
    aws/control-plane/plan-github
    aws/control-plane/plan-key
    aws/control-plane/publish-github
    aws/control-plane/publish-github-values
    aws/control-plane/read-plan
    aws/control-plane/read-outputs
    aws/control-plane/test
    aws/control-plane/validate-policies
    aws/cfn-guard
    aws/cloudformation-parameters
    aws/organization/log-archive/deploy
    aws/organization/log-archive/test
    aws/local-deployment
    aws/validate-guard-rules
    aws/test-cfn-guard
    github/configure-organization
    github/configure-repository
    github/apps/configure-app-environment
    github/apps/configure-ci-gate-app
    github/apps/configure-infrastructure-app
    github/apps/configure-maintenance-app
    github/apps/test-configure-app-environments
    github/apps/test-configure-ci-gate-app
    github/test-configure-organization
    github/test-configure-repository
    projects/reaveros/aws/configure-runner-app
    projects/reaveros/aws/create-function-archive
    projects/reaveros/aws/deploy-infrastructure
    projects/reaveros/aws/package-functions
    projects/reaveros/aws/plan-key
    projects/reaveros/aws/plan-infrastructure
    projects/reaveros/aws/read-plan
    projects/reaveros/aws/read-deployed-contract
    projects/reaveros/aws/functions/runner-control/test-coverage
    projects/reaveros/aws/functions/ci-gate/test-coverage
    projects/reaveros/aws/test-infrastructure
    projects/reaveros/aws/test-read-deployed-contract
    projects/reaveros/aws/test-configure-runner-app
    projects/reaveros/aws/test-validate-policies
    projects/reaveros/aws/validate-policies
    projects/reaveros/configure-ci
    projects/reaveros/test-configure-ci
    projects/reaveros/test-contract
)
bash -n "${shell_scripts[@]}"

json_files=(
    aws/organization/cost-controls.json
    aws/organization/reaver-project.json
    github/apps/ci-gate/manifest.json
    github/apps/infrastructure/manifest.json
    github/apps/maintenance/manifest.json
    github/apps/runner/manifest.json
    github/organizations/reaver-project.json
    github/repositories/infrastructure.json
    github/repositories/reaveros.json
)
for json_file in "${json_files[@]}"; do
    jq --exit-status . "${json_file}" > /dev/null
done

python3 -m py_compile \
    aws/organization/configure.py \
    aws/organization/cost_controls.py \
    aws/organization/test_configure.py \
    aws/organization/test_cost_controls.py \
    aws/organization/test_plan_contract.py \
    aws/src/reaver_project_aws/__init__.py \
    aws/src/reaver_project_aws/api.py \
    aws/src/reaver_project_aws/cost_controls.py \
    aws/src/reaver_project_aws/organization.py \
    aws/src/reaver_project_aws/plan_contract.py \
    github/apps/create \
    github/apps/test-create.py \
    projects/reaveros/aws/create-function-archive \
    projects/reaveros/aws/functions/github_app.py \
    projects/reaveros/aws/functions/ci-gate/index.py \
    projects/reaveros/aws/functions/ci-gate/lib.py \
    projects/reaveros/aws/functions/ci-gate/test.py \
    projects/reaveros/aws/functions/ci-gate/test_index.py \
    projects/reaveros/aws/functions/runner-control/index.py \
    projects/reaveros/aws/functions/runner-control/lib.py \
    projects/reaveros/aws/functions/runner-control/test.py \
    projects/reaveros/aws/functions/runner-control/test_index.py
python3 test-runtime-boundaries.py
node --check github/apps/configure-runner-group
node --check github/apps/test-configure-runner-group.js
uv run --project aws --frozen python github/test-workflows.py
python3 actions/test-infrastructure-consumer.py
python3 actions/test-update-infrastructure-consumer.py

actions/test
aws/control-plane/test
aws/test-cfn-guard
aws/organization/log-archive/test
uv run --project aws --frozen python aws/organization/test_configure.py
uv run --project aws --frozen python aws/organization/test_cost_controls.py
uv run --project aws --frozen python aws/organization/test_plan_contract.py
github/test-configure-organization
github/test-configure-repository
github/apps/test-configure-app-environments
github/apps/test-configure-ci-gate-app
python3 github/apps/test-create.py
node github/apps/test-configure-runner-group.js
projects/reaveros/aws/test-infrastructure
projects/reaveros/aws/test-read-deployed-contract
projects/reaveros/aws/test-configure-runner-app
projects/reaveros/aws/test-validate-policies
projects/reaveros/test-configure-ci
projects/reaveros/test-contract
python3 projects/reaveros/aws/functions/runner-control/test.py
python3 projects/reaveros/aws/functions/runner-control/test_index.py
python3 projects/reaveros/aws/functions/ci-gate/test.py
python3 projects/reaveros/aws/functions/ci-gate/test_index.py
projects/reaveros/aws/package-functions build/reaveros-lambda
test -f build/reaveros-lambda/ci-gate.zip
test -f build/reaveros-lambda/runner-control.zip
test ! -e build/reaveros-lambda/runner-reaper.zip
first_archive_hash=$(sha256sum \
    build/reaveros-lambda/ci-gate.zip \
    build/reaveros-lambda/runner-control.zip)
projects/reaveros/aws/package-functions build/reaveros-lambda
test "${first_archive_hash}" = "$(sha256sum \
    build/reaveros-lambda/ci-gate.zip \
    build/reaveros-lambda/runner-control.zip)"
printf 'Infrastructure tests passed.\n'
